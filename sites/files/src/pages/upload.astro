---
import LargeSection from "@sqky-one/common/layouts/LargeSection.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import FilesArchivePage from "@sqky-one/files/layouts/FilesArchivePage.astro";
---

<FilesArchivePage
    pageName="File Upload"
    desc="Direct file upload to my computer! You need a single-use code for this. (If I sent you a link, that means I generated a code for you :P)"
>
    <Fragment slot="page-title">Single Use File Upload</Fragment>

    <LargeSection>
        <Section>
            <h2>What is this?</h2>

            <p>
                This is a <em>file upload service</em>, directly to my personal computer!
                <br />
                You’ll need to be given a <em>code</em> to use this.
            </p>
            <p>
                If you received a link from me, that means you already have a code!
                <br />
                The code is <em>inside</em> the link itself, like this: <code>https://the.sqky.one/upload?code=ABCDEFGH</code>
            </p>

            <hr />

            <p>
                <label class="need-valid-code" for="file-progress">
                    Upload progress:
                </label>{" "}
                <progress id="file-progress" value="0"></progress>
            </p>
            <p>
                Status: <samp id="message"></samp>
            </p>

            <div class="need-valid-code">
                <div>
                    <input id="file-input" type="file" />
                    <button id="upload-button">Submit</button>
                </div>
            </div>
        </Section>
    </LargeSection>
</FilesArchivePage>

<style>
    #message {
        font-size: 0.9em;
        margin-inline: 0.2em;
    }

    .need-valid-code {
        display: none;
    }

    .need-valid-code[data-has-code="true"] {
        display: unset;
    }
</style>

<script>
    import { formatBytes } from "@sqky-one/common/lib/file";

    const elementsToUnhide = document.querySelectorAll<HTMLElement>(".need-valid-code");

    const button = document.querySelector<HTMLButtonElement>("#upload-button")!;
    const message = document.querySelector<HTMLElement>("#message")!;
    const fileProgress = document.querySelector<HTMLProgressElement>("#file-progress")!;
    const fileInput = document.querySelector<HTMLInputElement>("#file-input")!;

    const queryString = window.location.search;
    const params = new URLSearchParams(queryString);
    const code = params.get("code");

    document.addEventListener("DOMContentLoaded", () => {
        if (code) {
            message.textContent = "Idle.";
            for (const e of elementsToUnhide) {
                e.dataset.hasCode = "true";
            }
        } else {
            message.textContent = "Missing upload code!";
        }
    });

    async function handleClick() {
        if (!code) return;

        if (fileInput.files == null || fileInput.files.length == 0) {
            message.textContent = "No file selected!";
            return;
        }

        const file = fileInput.files![0];
        fileInput.value = "";
        fileInput.disabled = true;
        button.disabled = true;

        const xhr = new XMLHttpRequest();

        // todo abort button

        xhr.upload.addEventListener("loadstart", (event) => {
            fileProgress.value = 0;
            fileProgress.max = event.total;
            message.textContent = "Uploading…";
        });

        xhr.upload.addEventListener("progress", (event) => {
            fileProgress.value = event.loaded;
            message.textContent = `Uploading (${((event.loaded / event.total) * 100).toFixed(2)}% / ${formatBytes(event.loaded)} out of ${formatBytes(event.total)})…`;
        });

        xhr.addEventListener("readystatechange", () => {
            if (xhr.readyState === XMLHttpRequest.DONE) {
                if (xhr.status >= 200 && xhr.status < 300) {
                    message.textContent = "Successfully uploaded.";
                } else {
                    message.textContent = `Upload failed: Reason: ${xhr.status} ${xhr.statusText}`;
                }
            }
        });
        function errorAction(event: ProgressEvent) {
            fileProgress.value = 0;
            message.textContent = `Upload failed: ${event.type}`;
        }
        xhr.upload.addEventListener("error", errorAction);
        xhr.upload.addEventListener("abort", errorAction);
        xhr.upload.addEventListener("timeout", errorAction);
        xhr.upload.addEventListener("loadend", () => {
            fileInput.disabled = false;
            button.disabled = false;
        });

        xhr.open("PUT", `/upload/accept/${file.name}`, true);
        xhr.setRequestHeader("Authorization", code);
        xhr.setRequestHeader("Content-Type", file.type);
        xhr.send(file);
    }

    button.addEventListener("click", handleClick);
</script>
