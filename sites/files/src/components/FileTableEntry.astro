---
import FileIcon from "@sqky-one/common/components/FileIcon.astro";
import { formatBytes } from "@sqky-one/common/lib/file";
import { getMaterialFileIcon, getMaterialFolderIcon } from "@sqky-one/common/lib/material-icon";
import type { FileStats } from "@sqky-one/files/lib/files";

export type Props = {
    entry: FileStats;
};

const { entry } = Astro.props;
const url = new URL(Astro.request.url);
if (!url.pathname.endsWith("/")) {
    url.pathname += "/";
}

let suffix = "";
if (entry.isDir) {
    suffix += "/";
}

let icon: string = "file";
if (entry.isDir) {
    icon = getMaterialFolderIcon(entry.name);
}
if (entry.isFile) {
    icon = getMaterialFileIcon(entry.name);
}

const anchorExtraProps = entry.isDir ? { "data-astro-prefetch": "" } : {};

const readableDateFmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeStyle: "short" });
---

<tr>
    <td>
        <FileIcon name={icon} />
        <a href={URL.parse(`${entry.name}${suffix}`, url)?.pathname} {...anchorExtraProps}>{`${entry.name}${suffix}`}</a>
    </td>
    <td>
        <samp>{formatBytes(entry.size)}</samp>
    </td>
    <td>
        <time datetime={entry.mtime.toISOString()} title={readableDateFmt.format(entry.mtime)}>
            {`${entry.mtime.getFullYear()}/${(entry.mtime.getMonth() + 1).toString().padStart(2, "0")}/${entry.mtime.getDate().toString().padStart(2, "0")} ${entry.mtime.getHours().toString().padStart(2, "0")}:${entry.mtime.getMinutes().toString().padStart(2, "0")}`}
        </time>
    </td>
</tr>

<style>
    td {
        white-space: pre;
    }

    time {
        font-size: 0.85em;
        color: var(--smallColor);
    }
</style>
