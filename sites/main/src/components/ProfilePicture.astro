---
import Pfp from "@sqky-one/common/assets/profile_picture.png";
import Picture from "@sqky-one/common/components/Picture.astro";
---

<figure class="pfp-container">
    <p class="sr-only js-necessary">
        Below is a profile picture of a mouse hopping left and right. You can interact with it to make it squeak using either a keyboard or a mouse.
    </p>

    <div class="pfp">
        <div class="pfp-image-container">
            <Picture
                src={Pfp}
                class="pfp-image"
                alt="A drawing of the mouse. It's looking at the viewer with heart eyes and a happy expression. It has light blue hair, big ears, and pinkish fur. It's wearing a leather collar and tugging on it with its finger."
                draggable="false"
            />
        </div>
    </div>

    <figcaption class="pfp-caption">
        <p>
            it’s the mouse!!!!!! 🐁
            <small class="js-necessary">
                <br />
                (try patting it :3)
            </small>
        </p>

        <p>
            (art by <em>wereaegirnul</em>)
        </p>
    </figcaption>
</figure>

<style>
    @keyframes wobble {
        0% {
            transform: translateY(-2.5%) rotate(-5deg) translateY(0) translateX(-4%);
            animation-timing-function: ease-in;
        }

        25% {
            transform: translateY(-2.5%) rotate(0) translateY(10%) translateX(0);
            animation-timing-function: ease-out;
        }

        50% {
            transform: translateY(-2.5%) rotate(5deg) translateY(0) translateX(4%);
            animation-timing-function: ease-in;
        }

        75% {
            transform: translateY(-2.5%) rotate(0) translateY(10%) translateX(0);
            animation-timing-function: ease-out;
        }

        100% {
            transform: translateY(-2.5%) rotate(-5deg) translateY(0) translateX(-4%);
            animation-timing-function: ease-in;
        }
    }

    .pfp-container {
        flex: 1 2;

        height: min-content;

        margin: 0.5rem;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
        padding-inline: 0.8rem;
        border: 1px solid var(--headingColor);

        text-align: center;
    }

    .pfp,
    .pfp-image-container,
    .pfp-image {
        display: block;
        user-select: none;
        touch-action: none;

        width: 100%;
        height: auto;

        background-color: transparent;
        color: transparent;
    }

    .pfp,
    .pfp-image {
        border-radius: 9999px;
    }

    .pfp {
        width: max-content;

        padding-block: 1rem;
        padding-inline: 1rem;

        margin-inline: auto;
        margin-top: 0.8rem;
        margin-bottom: 1.6rem;
    }

    .pfp-image {
        max-width: 160px;
        margin-inline: auto;
        image-rendering: smooth;

        overflow: hidden;
    }

    @media (max-width: 440px) {
        .pfp-image {
            max-width: 128px;
        }
    }

    .pfp-image-container,
    .pfp-image {
        will-change: contents, transform, animation-timing-function, filter;
    }

    .pfp-image-container {
        animation: wobble 0.4s infinite alternate cubic-bezier(0.65, 0, 0.35, 1);
        transition: filter 0.07s cubic-bezier(0.32, 0.24, 0.11, 0.78);
    }

    .pfp-image-container[data-clicked="true"] {
        filter: brightness(110%) saturate(145%);
    }

    .pfp-image {
        filter: /*
        */ brightness(calc(100% * var(--brighten, 1))) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, var(--glow-alpha, 0)) -1px -1px) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, var(--glow-alpha, 0)) 1px -1px) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, var(--glow-alpha, 0)) -1px 1px) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, var(--glow-alpha, 0)) 1px 1px) /*

        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, calc(var(--glow-alpha, 0) * 0.85)) 0px 0px calc(1.5px * var(--glow-size, 1))) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, calc(var(--glow-alpha, 0) * 0.6)) 0px 0px calc(2px * var(--glow-size, 1))) /*
        */ drop-shadow(hsla(60, calc(100% * var(--glow-sat, 0)), 85%, calc(var(--glow-alpha, 0) * 0.6)) 0px 0px calc(3.5px * var(--glow-size, 1))) /*
        */ blur(calc(1px * var(--blur, 0)));
    }

    @media (prefers-reduced-motion) {
        .pfp-image-container,
        .pfp-image {
            transition: none !important;
            filter: none !important;
            animation: none !important;
            will-change: unset !important;
        }
    }

    .pfp-caption {
        display: block;
        width: 100%;

        margin-inline: auto;
    }
</style>

<script>
    const squeakSfxUrl = "/assets/squeak.ogg";
    const squeakSfxData = fetch(squeakSfxUrl).then((res) => res.arrayBuffer());

    const brightenVar = "--brighten";
    const glowSaturationVar = "--glow-sat";
    const glowAlphaVar = "--glow-alpha";
    const glowSizeVar = "--glow-size";
    const blurVar = "--blur";

    let count = 0;
    let resting = true;
    const FALLOFF_TIME = 350;
    const EXP_FALLOFF_TIME = 1400;
    const CLICKING_TIME = 110;

    let lastTime = 0;
    let lastClickTime = 0;

    const context = new AudioContext({ latencyHint: "interactive", sampleRate: 44100 });
    const squeakSfx = squeakSfxData.then((v) => context.decodeAudioData(v));

    const play = async () => {
        await context.resume();

        const source = new AudioBufferSourceNode(context, {
            buffer: await squeakSfx,
        });
        source.connect(context.destination);
        source.start();

        count++;
        lastClickTime = lastTime;
        resting = false;
    };

    document.querySelectorAll<HTMLDivElement>(".pfp").forEach((element) => {
        element.style.cursor = "pointer";
        element.role = "button";
        element.tabIndex = 0;

        const disallowedKeys = ["Tab", "Arrow", "Escape"];

        element.addEventListener("click", (event) => {
            event.preventDefault();
            play();
        });
        element.addEventListener("keydown", (event) => {
            if (!event.ctrlKey && !event.shiftKey && !event.altKey && !event.metaKey && disallowedKeys.find((key) => event.key.includes(key)) == undefined) {
                event.preventDefault();
                play();
            }
        });
    });

    document.addEventListener("DOMContentLoaded", () => {
        const imageContainers = document.querySelectorAll<HTMLElement>(".pfp-image-container");
        const images = document.querySelectorAll<HTMLElement>(".pfp-image");
        let dT = 0;
        let dTClick = 0;

        const animate = (time: DOMHighResTimeStamp) => {
            if (lastTime) {
                dT = time - lastTime;
            }
            if (lastClickTime) {
                dTClick = time - lastClickTime;
            }

            if (!resting && lastClickTime) {
                for (const container of imageContainers) {
                    container.dataset.clicked = (dTClick < CLICKING_TIME).toString();
                }
            }

            if (!resting) {
                if (lastClickTime && dTClick > EXP_FALLOFF_TIME && count > 20) {
                    count -= count * 0.0065 * (dT / 16.66);
                }

                if (lastTime) {
                    count = Math.max(0, count - dT / FALLOFF_TIME);
                }
            }

            if (count < 0.01) {
                count = 0.0;
                if (!resting) {
                    resting = true;
                    for (const container of imageContainers) {
                        try {
                            container.getAnimations()[0].updatePlaybackRate(1);
                        } catch {
                            /* empty */
                        }
                        delete container.dataset.clicked;
                    }
                    for (const image of images) {
                        image.style.removeProperty(brightenVar);
                        image.style.removeProperty(glowSaturationVar);
                        image.style.removeProperty(glowAlphaVar);
                        image.style.removeProperty(glowSizeVar);
                        image.style.removeProperty(blurVar);
                    }
                }
            }

            if (!resting) {
                const v = 1.9;
                const r = 4.7;
                const a = 9.5;
                const x = count / 80;
                const p = Math.pow(r * x, v);
                const speed = Math.max(1, 2 + (p - a) / (p + a));

                const brighten = Math.max(1, Math.min(Math.pow(speed, 0.2), 1.25));
                const glowSaturation = Math.max(0, Math.min(Math.pow(speed, 0.75) - 1.0, 1.0));
                const glowAlpha = Math.max(0, Math.min(Math.pow(speed, 1.15) - 1.0, 0.6));
                const glowSize = Math.max(1, Math.min(Math.pow(speed, 2.4) - 2.5, 8));
                const blur = Math.max(0, Math.min(Math.pow(speed, 1.15) - 2.3, 1.4));

                for (const image of imageContainers) {
                    try {
                        image.getAnimations()[0].updatePlaybackRate(speed);
                    } catch {
                        /* empty */
                    }
                    image.style.setProperty(brightenVar, brighten.toString());
                    image.style.setProperty(glowSaturationVar, glowSaturation.toString());
                    image.style.setProperty(glowAlphaVar, glowAlpha.toString());
                    image.style.setProperty(glowSizeVar, glowSize.toString());
                    image.style.setProperty(blurVar, blur.toString());
                }
            }

            lastTime = time;
            window.requestAnimationFrame(animate);
        };

        window.requestAnimationFrame(animate);
    });
</script>
