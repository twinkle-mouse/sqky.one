<style>
    @media (prefers-reduced-motion) {
        .gaysphere-container {
            display: none !important;
        }
    }

    .gaysphere {
        display: flex;
        justify-content: center;
        align-items: center;

        min-width: calc(var(--s) * 2);
        min-height: calc(var(--s) * 2);
        height: auto;

        margin-block: 1.5rem;
        margin-inline: 0.5rem;

        user-select: none;

        transition: filter 0.5s ease;
    }

    .gaysphere:hover {
        filter: drop-shadow(0px 0px calc(var(--s) / 12) rgba(255, 255, 255, 0.25)) drop-shadow(0px 0px calc(var(--s) / 8) rgba(255, 255, 255, 0.5))
            drop-shadow(0px 0px calc(var(--s) / 6) rgba(255, 255, 255, 0.75));
    }

    .anim {
        width: 100%;
        height: 100%;

        transform-style: preserve-3d;
        backface-visibility: hidden;
        animation-composition: add;
    }
</style>

<style lang="scss">
    @use "sass:math";

    $ngon: 5;
    $pentAngle: calc(360deg / $ngon);
    $r3gon: 1;
    $h3gon2: calc(cos($pentAngle / 2) * $r3gon);
    $a3gon2: calc(2 * sin($pentAngle / 2) * $r3gon);
    $h5gon: calc($r3gon + $h3gon2);
    $sideH: calc(sin($pentAngle) * $a3gon2);
    $medianH5side: calc(($h5gon + $sideH) / 2);
    $medRatio: calc($medianH5side / $h5gon);
    $pyrAngle: calc(asin($h3gon2 / $h5gon));
    $pyrH: calc(cos($pyrAngle) * $h5gon);
    $dodecaH: calc(2 * $pyrH * $medRatio);
    $centrAngle: calc(atan($r3gon / calc($dodecaH / 2)));
    $r5gon: calc(sin($centrAngle) * 50);
    $offset5gon: calc(cos($centrAngle) * 50);
    $a3gon: calc(2 * sin(36deg) * $r5gon);
    $h3gon: calc(cos(36deg) * $r5gon);

    $horizQ1: calc(50 * sin($centrAngle / 2));
    $vertiQ1: calc(50 * cos($centrAngle / 2));
    $q1sideAngle: calc(atan((50 - $vertiQ1) / $horizQ1));
    $q1side: calc(1 / cos($q1sideAngle) * $horizQ1);
    $hq1r5Ratio: calc($horizQ1 / $r5gon);
    $q1width: calc($a3gon * $hq1r5Ratio);
    $q1innerAngle: calc(asin(($q1width / 2) / $q1side));
    $q1height: calc(cos($q1innerAngle) * $q1side);
    $q1inclineAngle: acos(calc((50 - $vertiQ1)) / $q1height);

    $squishedAngle: calc(atan($h3gon / $offset5gon));
    $horizQ2: calc(50 * sin($squishedAngle));
    $vertiQ2: calc(50 * cos($squishedAngle));
    $deltaHorizQ12: calc($horizQ2 - $horizQ1 * cos(36deg));
    $deltaVertQ12: calc($vertiQ1 - $vertiQ2);
    $q2inclineAngle: calc(atan($deltaVertQ12 / $deltaHorizQ12));
    $q2height: calc(1 / cos($q2inclineAngle) * $deltaHorizQ12);
    $q2innerAngle: calc(atan(($q1width / 2) / $q2height));
    $q2side: calc(1 / cos($q2innerAngle) * $q2height);

    .scene {
        height: calc(var(--s) * 1.5);
        aspect-ratio: 1;

        border-radius: 9999px;
        background-color: #4444;
        filter: drop-shadow(0 0 4px #000);
    }

    .scene *,
    .scene *::before {
        position: absolute;
        transform-style: preserve-3d;
    }

    .geodesic {
        inset: 0;
        animation: spin 0s linear infinite;
    }

    .pentagon {
        inset: 0;
        display: grid;
        justify-items: center;
    }

    .pentagon div {
        backface-visibility: hidden;
    }

    @mixin side($i, $sideStep, $pentaDir) {
        .side:nth-of-type(#{$i}) {
            transform: rotateX(calc($sideStep * 72deg + 18deg * (1 + $pentaDir))) rotate(calc($pyrAngle * $pentaDir)) rotateY(calc(90deg * (1 - $pentaDir)));
        }
    }

    @mixin lid($i, $pentaDir) {
        .lid:nth-of-type(#{$i}) {
            rotate: calc(90deg * $pentaDir);
        }
    }

    @for $i from 1 through 12 {
        @include side($i, math.floor(calc($i / 2)), ($i % 2) * 2 - 1);
    }

    @for $i from 1 through 12 {
        @include lid($i, ($i % 2) * 2 - 1);
    }

    .quarter1 {
        width: calc($q1width * calc(var(--s) * 0.015));
        height: calc($q1height * calc(var(--s) * 0.015));

        transform-origin: 50% 0;
    }

    .quarter2 {
        width: 100%;
        height: calc($q2height * calc(var(--s) * 0.015));
        top: 95%;
        transform-origin: 50% 0;
    }

    @mixin quarter($i, $secStep) {
        .quarter1:nth-of-type(#{$i}) {
            transform: rotateY(calc($secStep * 72deg + 90deg)) rotateX($q1inclineAngle);

            background-image: conic-gradient(
                from calc(180deg - $q1innerAngle) at 50% -2%,
                hsl(calc(72deg * ($secStep + 1)) 100% 50%),
                hsl(calc(72deg * $secStep) 100% 50%) calc($q1innerAngle * 2),
                #0000 calc($q1innerAngle * 2)
            );

            & > .quarter2 {
                background-image: conic-gradient(
                    from calc(0deg - $q2innerAngle) at 50% 105%,
                    hsl(calc(72deg * $secStep) 100% 50%),
                    hsl(calc(72deg * ($secStep + 1)) 100% 50%) calc($q2innerAngle * 2),
                    #0000 calc($q2innerAngle * 2)
                );
                rotate: x calc(-1 * $q1inclineAngle + 90deg - $q2inclineAngle);
            }
        }
    }

    @for $i from 1 through 5 {
        @include quarter($i, $i - 1);
    }
</style>

