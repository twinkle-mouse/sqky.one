<style>
    .gaysphere {
        --s: 96px;
    }

    @media (max-width: 1300px) {
        .gaysphere {
            --s: 64px;
        }
    }
</style>

<style>
    .gaysphere-container {
        display: flex;
        justify-content: center;
        align-items: center;

        width: 100%;
        height: 100%;

        padding-inline: 0.5rem;
        padding-block: 1.5em;

        user-select: none;
    }

    .gaysphere {
        perspective: calc(var(--s) * 5);

        width: calc(var(--s) * 1.5);
        height: calc(var(--s) * 1.5);

        margin: calc(var(--s) * 0.25);

        transition: filter 0.5s ease;

        border-radius: 9999px;
        background-color: #4444;
        filter: drop-shadow(0 0 4px #000);
    }

    .gaysphere:hover {
        filter: /*
        */ drop-shadow(0px 0px calc(var(--s) / 12) rgba(255, 255, 255, 0.25)) /*
        */ drop-shadow(0px 0px calc(var(--s) / 10) rgba(255, 255, 255, 0.5)) /*
        */ drop-shadow(0px 0px calc(var(--s) / 8) rgba(255, 255, 255, 0.75));
    }
</style>

<style lang="scss">
    @use "sass:math";

    $ngon: 5;
    $pentAngle: calc(360deg / $ngon);
    $r3gon: 1;
    $h3gon2: calc(cos($pentAngle / 2) * $r3gon);
    $a3gon2: calc(2 * sin($pentAngle / 2) * $r3gon);
    $h5gon: calc($r3gon + $h3gon2);
    $sideH: calc(sin($pentAngle) * $a3gon2);
    $medianH5side: calc(($h5gon + $sideH) / 2);
    $medRatio: calc($medianH5side / $h5gon);
    $pyrAngle: calc(asin($h3gon2 / $h5gon));
    $pyrH: calc(cos($pyrAngle) * $h5gon);
    $dodecaH: calc(2 * $pyrH * $medRatio);
    $centrAngle: calc(atan($r3gon / calc($dodecaH / 2)));
    $r5gon: calc(sin($centrAngle) * 50);
    $offset5gon: calc(cos($centrAngle) * 50);
    $a3gon: calc(2 * sin(36deg) * $r5gon);
    $h3gon: calc(cos(36deg) * $r5gon);

    $horizQ: calc(50 * sin($centrAngle / 2));
    $vertiQ: calc(50 * cos($centrAngle / 2));
    $qSideAngle: calc(atan((50 - $vertiQ) / $horizQ));
    $qSide: calc(1 / cos($qSideAngle) * $horizQ);
    $hQR5Ratio: calc($horizQ / $r5gon);
    $qWidth: calc($a3gon * $hQR5Ratio);
    $qInnerAngle: calc(asin(($qWidth / 2) / $qSide));
    $qHeight: calc(cos($qInnerAngle) * $qSide);
    $qInclineAngle: acos(calc((50 - $vertiQ)) / $qHeight);

    .pentagon {
        width: 100%;
        height: 100%;
        display: grid;
        justify-items: center;
    }

    .pentagon,
    .pentagon *,
    .pentagon *::before {
        position: absolute;
        transform-style: preserve-3d;
        backface-visibility: hidden;
    }

    @mixin side($i, $sideStep, $pentaDir) {
        .side:nth-of-type(#{$i}) {
            transform: rotateX(calc($sideStep * 72deg + 18deg * (1 + $pentaDir))) rotate(calc($pyrAngle * $pentaDir)) rotateY(calc(90deg * (1 - $pentaDir)));
        }
    }

    @mixin lid($i, $pentaDir) {
        .lid:nth-of-type(#{$i}) {
            rotate: calc(90deg * $pentaDir);
        }
    }

    @for $i from 1 through 12 {
        @include side($i, math.floor(calc($i / 2)), ($i % 2) * 2 - 1);
    }

    @for $i from 1 through 12 {
        @include lid($i, ($i % 2) * 2 - 1);
    }

    @mixin quarter($i, $secStep) {
        .quarter:nth-of-type(#{$i}) {
            transform: rotateY(calc($secStep * 72deg + 90deg)) rotateX($qInclineAngle);

            width: calc($qWidth * calc(var(--s) * 0.015));
            height: calc($qHeight * calc(var(--s) * 0.015));

            transform-origin: 50% 0;

            background-image: conic-gradient(
                from calc(180deg - $qInnerAngle) at 50% -2%,
                hsl(calc(72deg * ($secStep + 1)) 100% 50%),
                hsl(calc(72deg * $secStep) 100% 50%) calc($qInnerAngle * 2),
                #0000 calc($qInnerAngle * 2)
            );

            &::before {
                content: "";
                display: block;

                width: 100%;
                height: 100%;

                translate: 0 calc(100% - 1px);

                background-image: conic-gradient(
                    from calc(0deg - $qInnerAngle) at 50% 105%,
                    hsl(calc(72deg * $secStep) 100% 50%),
                    hsl(calc(72deg * ($secStep + 1)) 100% 50%) calc($qInnerAngle * 2),
                    #0000 calc($qInnerAngle * 2)
                );
            }
        }
    }

    @for $i from 1 through 5 {
        @include quarter($i, $i - 1);
    }
</style>
