---
import Section from "@sqky-one/common/layouts/Section.astro";

import IntroContent from "./md/Intro.mdx";
import ProfilePicture from "./ProfilePicture.astro";
---

<Section>
    <div class="profile">
        <div class="profile-intro">
            <IntroContent />
        </div>

        <ProfilePicture />
    </div>
</Section>

<style>
    .profile {
        display: flex;
        width: 100%;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .profile-intro {
        flex: 2 1 340px;
    }
</style>
