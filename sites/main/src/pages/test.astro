---
import Details from "@sqky-one/common/components/Details.astro";
import EmojiWrapper from "@sqky-one/common/components/EmojiWrapper.astro";
import InputCheckbox from "@sqky-one/common/components/InputCheckbox.astro";
import InputNumeric from "@sqky-one/common/components/InputNumeric.astro";
import InputRadio from "@sqky-one/common/components/InputRadio.astro";
import InputSearch from "@sqky-one/common/components/InputSearch.astro";
import InputText from "@sqky-one/common/components/InputText.astro";
import PublicTextFile from "@sqky-one/common/components/PublicTextFile.astro";
import LargeSection from "@sqky-one/common/layouts/LargeSection.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import MainPage from "@sqky-one/main/layouts/MainPage.astro";
import WritingSection from "@sqky-one/writing/layouts/WritingSection.astro";
---

<MainPage pageName="TESTING TESTS" desc="Page to test my website's styles: very inaccessible! Open at your own discretion.">
    <Fragment slot="page-title">TESTING TESTS</Fragment>

    <Fragment slot="nav:page-links">
        <li>
            <a>The Good Shit™</a>
        </li>
    </Fragment>

    <EmojiWrapper>
        <LargeSection>
            <Section>
                <div>
                    <input id="test-file-input" type="file" />
                    <button id="test-button">Submit</button>
                </div>
                <div>
                    <InputSearch id="test-search-input" target="aaa" values={["bbb"]}>
                        Search Input Lalala
                    </InputSearch>
                </div>
                <div>
                    <InputText id="test-text-input">Text Input Lalala</InputText>
                </div>
                <div>
                    <InputNumeric id="test-numeric-input" min="12" max="28">
                        Numeric Input Lalala
                    </InputNumeric>
                </div>
                <div>
                    <InputCheckbox id="test-checkbox1">Foobar</InputCheckbox>
                    <InputCheckbox id="test-checkbox2" checked>
                        Barfoo
                    </InputCheckbox>
                </div>

                <div>
                    <span>Presets: </span>
                    <InputRadio name="controls-font-family-preset" id="controls-font-family-preset-unset" value="">
                        Site Default
                    </InputRadio>
                    <InputRadio name="controls-font-family-preset" id="controls-font-family-preset-ibm-plex-sans" value="var(--font-ibm-plex-sans)">
                        IBM Plex Sans
                    </InputRadio>
                    <InputRadio name="controls-font-family-preset" id="controls-font-family-preset-inter" value="var(--font-inter)">
                        Inter
                    </InputRadio>
                    <InputRadio name="controls-font-family-preset" id="controls-font-family-preset-noto-sans" value="var(--font-noto-sans)">
                        Noto Sans
                    </InputRadio>
                    <InputRadio name="controls-font-family-preset" id="controls-font-family-preset-roboto" value="var(--font-roboto)">
                        Roboto
                    </InputRadio>
                </div>

                <PublicTextFile src="pubkey.asc" summary="my PGP public key" />

                <Details summary="Content Warnings">
                    <div>
                        <p>THIS IS A TEST</p>
                    </div>
                </Details>

                <p>
                    meow💀meow
                    <br />
                    🥰meow™meow💀✌️🌴🐢🐐🍄⚽🍻👑📸😬👀🚨🏡🕊️🏆😻🌟🧿🍀🎨🍜
                </p>

                <p style="font-size: 60px;">
                    meow💀meow
                    <br />
                    🥰meow™meow💀✌️🌴🐢🐐🍄⚽🍻👑📸😬👀🚨🏡🕊️🏆😻🌟🧿🍀🎨🍜
                </p>

                <p style="font-size: 10px;">
                    meow💀meow
                    <br />
                    🥰meow™meow💀✌️🌴🐢🐐🍄⚽🍻👑📸😬👀🚨🏡🕊️🏆😻🌟🧿🍀🎨🍜
                </p>

                <WritingSection data-section-depth="2">
                    <h2>The Good Shit™ H2</h2>
                    <WritingSection data-section-depth="3">
                        <h3>The Good Shit™ H3</h3>
                        <WritingSection data-section-depth="4">
                            <h4>The Good Shit™ H4</h4>
                        </WritingSection>
                    </WritingSection>
                </WritingSection>
                <WritingSection data-section-depth="2">
                    <h2>The Bad Shit</h2>
                </WritingSection>
            </Section>
        </LargeSection>
    </EmojiWrapper>
</MainPage>
