---
import { transform } from "./util";

export type Props = {
    cap?: boolean;
};

const { cap = false } = Astro.props;
---

<span>
    <span class="show-with-flag" data-flag="__settings-pronouns-he">
        {transform(cap, "himself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-she">
        {transform(cap, "herself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-they">
        {transform(cap, "themselves")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-it">
        {transform(cap, "itself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-one">
        {transform(cap, "oneself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-ze">
        {transform(cap, "zirself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-ae">
        {transform(cap, "aerself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-xe">
        {transform(cap, "xemself")}
    </span>
    <span class="show-with-flag" data-flag="__settings-pronouns-fae">
        {transform(cap, "faerself")}
    </span>
    <span class="show-with-flag __pronouns-reflexive-custom" data-flag="__settings-pronouns-custom"></span>
</span>
