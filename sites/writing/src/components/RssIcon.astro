---
import Icon, { type Props as P } from "@sqky-one/common/components/Icon.astro";

export type Props = Omit<P, "name">;
const { class: clazz, ...props } = Astro.props;
---

<Icon {...props} class:list={[clazz, "rss-icon"]} name="logo/rss" />

<style>
    .rss-icon {
        color: #ffc760;
        margin-right: 0.4em;
    }

    .rss-icon[data-glow="true"] {
        --glow-blur-size: 2px;
        transition: filter 0.2s;
        filter: drop-shadow(0px 0px var(--glow-blur-size));
    }

    .rss-icon[data-glow="true"]:hover,
    :global(:focus-visible > .rss-icon[data-glow="true"]),
    :global(:hover > .rss-icon[data-glow="true"]) {
        filter: drop-shadow(0px 0px var(--glow-blur-size)) drop-shadow(0px 0px 6px #ffc76050);
    }
</style>
