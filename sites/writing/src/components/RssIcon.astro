---
import Svg from "@sqky-one/common/assets/icons/rss.svg";
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"span">;
const props = Astro.props;
---

<span class="icon" {...props}>
    <template shadowrootmode="open">
        <Svg width="1.5em" height="1.5em" aria-hidden="true" />
    </template>
</span>

<style>
    .icon {
        color: #ffc760;
        display: inline-block;
        vertical-align: -0.4em;
        margin-right: 0.4em;
        line-height: 0;
    }

    .icon[data-glow="true"] {
        --glow-blur-size: 2px;
        transition: filter 0.2s;
        filter: drop-shadow(0px 0px var(--glow-blur-size));
    }

    .icon[data-glow="true"]:hover,
    :global(:focus-visible > .icon[data-glow="true"]),
    :global(:hover > .icon[data-glow="true"]) {
        filter: drop-shadow(0px 0px var(--glow-blur-size)) drop-shadow(0px 0px 6px #ffc76050);
    }
</style>
