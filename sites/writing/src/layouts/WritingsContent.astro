---
import "@sqky-one/common/assets/content.css";

import EmojiWrapper from "@sqky-one/common/components/EmojiWrapper.astro";
import LargeSection from "@sqky-one/common/layouts/LargeSection.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import WritingsSection from "./WritingsSection.astro";

type Props = {
    Content: AstroComponentFactory;
};

const { Content } = Astro.props;
---

<LargeSection type="article" class="writing">
    <style>
        .writing {
            padding-block: 0.8em;
            padding-inline: 0.6rem;
        }

        @media (max-width: 900px) {
            .writing {
                padding-block: 0.25em;
            }
        }

        @media (max-width: 640px) {
            .writing {
                padding-block: 0em;
            }
        }
    </style>

    <div id="content">
        <EmojiWrapper isContentful={true}>
            <Content
                components={{
                    section: WritingsSection,
                }}
            />
        </EmojiWrapper>

        <style is:global>
            #content ::before,
            #content ::after {
                content: unset;
            }

            #content summary::before {
                content: "";
            }

            #content {
                overflow: auto;

                font-size: 1.25rem;
                padding-inline: 1rem;
            }

            @media (max-width: 900px) {
                #content {
                    font-size: 1.1rem;
                    padding-inline: 0.6rem;
                }
            }

            @media (max-width: 640px) {
                #content {
                    font-size: 1rem;
                    padding-inline: 0.25rem;
                }
            }

            #content p {
                margin-block: 1em;
                line-height: 1.4;
            }

            #content li {
                margin-block: 0.8em;
            }

            #content h1,
            #content h2,
            #content h3,
            #content h4,
            #content h5,
            #content h6 {
                text-align: center;
                font-weight: 500;
            }

            #content section {
                margin-inline: 0;
                margin-block: 1rem;
            }

            #content blockquote {
                font-style: normal;
            }

            #content code {
                word-break: break-all;
            }
        </style>
    </div>
</LargeSection>
