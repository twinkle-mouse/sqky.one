                try {
                    if (isNullish) {
                        window.localStorage.setItem(this.key, "");
                    } else {
                        window.localStorage.setItem(this.key, value);
                    }
                } catch {
                    // ignore
                }

                if (isNullish) {
                    content.style.fontSize = "";
                } else {
                    content.style.fontSize = value;
                }

                fontSizePixels.clear();
                presetFontSizeChanged();
            },
        };

        {
