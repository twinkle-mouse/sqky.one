---
import Checkbox from "@sqky-one/common/components/Checkbox.astro";
import Details from "@sqky-one/common/components/Details.astro";
import NumericInput from "@sqky-one/common/components/NumericInput.astro";
import RadioInput from "@sqky-one/common/components/RadioInput.astro";
import TextInput from "@sqky-one/common/components/TextInput.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
---

<Section class="controls js-necessary">
    <h2>
        <i>Controls</i>
    </h2>

    <p>
        <i>Below is a few inputs for controlling the visuals of the writing.</i>
        <br />
        <i>Any values changed here will be saved to your browser for reuse across all writings on the Stardew Library.</i>
    </p>

    <Details summary="Display Controls">
        <div class="controls">
            <fieldset>
                <legend>Font family:</legend>

                <div>
                    <label>Presets:</label>
                    <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-unset" value="">
                        Site Default
                    </RadioInput>
                    <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-ibm-plex-sans" value="var(--font-ibm-plex-sans)">
                        IBM Plex Sans
                    </RadioInput>
                    <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-inter" value="var(--font-inter)">
                        Inter
                    </RadioInput>
                    <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-noto-sans" value="var(--font-noto-sans)">
                        Noto Sans
                    </RadioInput>
                    <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-roboto" value="var(--font-roboto)">
                        Roboto
                    </RadioInput>
                </div>

                <div>
                    <TextInput id="controls-font-family-custom">Custom font:</TextInput>
                </div>
            </fieldset>

            <fieldset>
                <legend>Font size:</legend>

                <div>
                    <label>Presets:</label>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-unset" value="">
                        Site Default
                    </RadioInput>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-x-small" value="x-small">
                        Extra Small
                    </RadioInput>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-small" value="small">
                        Small
                    </RadioInput>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-medium" value="medium">
                        Normal
                    </RadioInput>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-large" value="large">
                        Large
                    </RadioInput>
                    <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-x-large" value="x-large">
                        Extra Large
                    </RadioInput>
                </div>

                <div>
                    <NumericInput id="controls-font-size-pixels" min="12" max="28">
                        Pixel value:
                    </NumericInput>
                </div>
            </fieldset>

            <fieldset>
                <legend>Line height:</legend>

                <div>
                    <label>Presets:</label>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-unset" value="">
                        Site Default
                    </RadioInput>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-x-small" value="1.0">
                        Extra Small
                    </RadioInput>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-small" value="1.1">
                        Small
                    </RadioInput>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-medium" value="1.2">
                        Normal
                    </RadioInput>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-large" value="1.4">
                        Large
                    </RadioInput>
                    <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-x-large" value="1.6">
                        Extra Large
                    </RadioInput>
                </div>

                <div>
                    <NumericInput id="controls-line-height-em" min="1.0" max="2.0" step="0.1">
                        By font size (em):
                    </NumericInput>
                </div>
            </fieldset>

            <fieldset>
                <legend>Layout stuffs:</legend>

                <p>
                    In most of my writings, I manually enter linebreaks to break up long lines, targeting a specific view width.
                    <br />
                    However, this might not be ideal if you are, for example, reading on mobile. You can collapse all manual linebreaks below.
                    <br />
                    (This does not, however, affect quotes, because they are usually intentionally formatted in a specific way.)
                    <br />
                    <Checkbox id="controls-layout-collapse-manual-linebreaks">Collapse manual linebreaks?</Checkbox>
                </p>

                <p>
                    On desktop view, the navigation is turned into a sidebar.
                    <br />
                    You might not want this behaviour, and you can disable it below.
                    <br />
                    <Checkbox id="controls-layout-force-mobile">Force mobile layout?</Checkbox>
                </p>

                <p>
                    The website has a large amount of padding on the left and right edges in order to centre the page content and direct flow.
                    <br />
                    If you would prefer not having any paddings and instead letting the content fill the entire width, you can do so below.
                    <br />
                    <Checkbox id="controls-layout-remove-page-padding">Remove page padding?</Checkbox>
                </p>

                <p>
                    On narrower displays, the website automatically adjusts to reduce the margins on the left and right sides of sections.
                    <br />
                    However, that might not be enough for you, or you just do not want any margins whatsoever.
                    <br />
                    If so, you can collapse all margins below; this also disables any kinds of borders or shadows on the sections.
                    <br />
                    <Checkbox id="controls-layout-collapse-margins">Collapse margins?</Checkbox>
                </p>
            </fieldset>
        </div>
    </Details>
</Section>

<style>
    .controls {
        padding-bottom: 1.4rem;
    }
</style>

<!-- controls: font family -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const content = document.getElementById("content")!;

        const fontFamilyCustom = {
            key: "font-family-custom",
            element: document.getElementById("controls-font-family-custom")! as HTMLInputElement,

            get() {
                try {
                    return window.localStorage.getItem(this.key);
                } catch {
                    return null;
                }
            },

            clear() {
                try {
                    window.localStorage.removeItem(this.key);
                } catch {
                    // ignore
                }
            },

            set(value: string | null) {
                // don't want to compare it as a number like "0"
                const isNullish = value === null || value === "";

                try {
                    if (isNullish) {
                        window.localStorage.setItem(this.key, "");
                    } else {
                        window.localStorage.setItem(this.key, value);
                    }
                } catch {
                    // ignore
                }

                if (isNullish) {
                    content.style.fontFamily = "";
                } else {
                    content.style.fontFamily = value;
                }

                for (const e of fontSizePreset.elements) {
                    e.checked = false;
                }
                fontSizePreset.clear();
            },
        };

        const fontSizePreset = {
            key: "font-family-preset",
            elements: [
                "controls-font-family-preset-unset",
                "controls-font-family-preset-ibm-plex-sans",
                "controls-font-family-preset-inter",
                "controls-font-family-preset-noto-sans",
                "controls-font-family-preset-roboto",
            ].map((id) => document.getElementById(id)! as HTMLInputElement),

            get() {
                try {
                    return window.localStorage.getItem(this.key);
                } catch {
                    return null;
                }
            },

            clear() {
                try {
                    window.localStorage.removeItem(this.key);
                } catch {
                    // ignore
                }
            },

            set(value: string | null) {
                // don't want to compare it as a number like "0"
                const isNullish = value === null || value === "";

                try {
                    if (isNullish) {
                        window.localStorage.setItem(this.key, "");
                    } else {
                        window.localStorage.setItem(this.key, value);
                    }
                } catch {
                    // ignore
                }

                if (isNullish) {
                    content.style.fontFamily = "";
                } else {
                    content.style.fontFamily = value;
                }

                fontFamilyCustom.clear();
            },
        };

        {
            const custom = fontFamilyCustom.get();
            const preset = fontSizePreset.get();

            if (custom) {
                fontFamilyCustom.element.value = custom;
                fontFamilyCustom.set(custom);
            } else if (preset) {
                fontSizePreset.set(preset);
            } else {
                fontSizePreset.set("");
            }
        }

        {
            fontFamilyCustom.element.addEventListener("input", (event) => {
                const target = event.target;
                if (target instanceof HTMLInputElement) {
                    fontFamilyCustom.set(target.value || target.defaultValue);
                }
            });
        }

        for (const e of fontSizePreset.elements) {
            const current = fontSizePreset.get();
            if (current === e.value) {
                e.checked = true;
            } else {
                e.checked = false;
            }

            e.addEventListener("input", (event) => {
                const target = event.target;
                if (target instanceof HTMLInputElement) {
                    fontSizePreset.set(target.value);
                }
            });
        }
    });
</script>

