---
import Details from "@sqky-one/common/components/Details.astro";
import InputCheckbox from "@sqky-one/common/components/InputCheckbox.astro";
import InputNumeric from "@sqky-one/common/components/InputNumeric.astro";
import InputRadio from "@sqky-one/common/components/InputRadio.astro";
import InputText from "@sqky-one/common/components/InputText.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import ExampleWriting from "@sqky-one/writing/components/ExampleWriting.mdx";

export type Props = {
    showExample?: boolean;
};

const { showExample = false } = Astro.props;
---

<Section class="js-necessary">
    <h2>
        <i>Controls</i>
    </h2>

    <p>
        <i>Below is a few inputs for controlling the visuals of the writing.</i>
        <br />
        <i>Any values changed here will be saved to your browser for reuse across all writings on the Stardew Library.</i>
    </p>

    <Details summary="Display Controls">
        <div class="controls">
            <div class="controls-group controls-group-fonts">
                <fieldset>
                    <legend>Font family:</legend>

                    <div class="presets">
                        <span>Presets: </span>
                        <InputRadio name="controls-font-family-preset" shouldSaveValue id="controls-font-family-preset-unset" value="" checked>
                            Site Default
                        </InputRadio>
                        <InputRadio
                            name="controls-font-family-preset"
                            shouldSaveValue
                            id="controls-font-family-preset-ibm-plex-sans"
                            value="var(--font-ibm-plex-sans)"
                        >
                            IBM Plex Sans
                        </InputRadio>
                        <InputRadio name="controls-font-family-preset" shouldSaveValue id="controls-font-family-preset-inter" value="var(--font-inter)">
                            Inter
                        </InputRadio>
                        <InputRadio name="controls-font-family-preset" shouldSaveValue id="controls-font-family-preset-noto-sans" value="var(--font-noto-sans)">
                            Noto Sans
                        </InputRadio>
                        <InputRadio name="controls-font-family-preset" shouldSaveValue id="controls-font-family-preset-roboto" value="var(--font-roboto)">
                            Roboto
                        </InputRadio>
                    </div>

                    <InputText name="controls-font-family-custom" shouldSaveValue id="controls-font-family-custom">
                        Custom font:
                    </InputText>
                </fieldset>

                <fieldset>
                    <legend>Font size:</legend>

                    <div class="presets">
                        <span>Presets: </span>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-unset" value="" checked>
                            Site Default
                        </InputRadio>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-x-small" value="x-small">
                            Extra Small
                        </InputRadio>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-small" value="small">
                            Small
                        </InputRadio>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-medium" value="medium">
                            Normal
                        </InputRadio>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-large" value="large">
                            Large
                        </InputRadio>
                        <InputRadio name="controls-font-size-preset" shouldSaveValue id="controls-font-size-preset-x-large" value="x-large">
                            Extra Large
                        </InputRadio>
                    </div>

                    <InputNumeric name="controls-font-size-custom" shouldSaveValue id="controls-font-size-custom" min="12" max="28">
                        Pixel value:
                    </InputNumeric>
                </fieldset>

                <fieldset>
                    <legend>Line height:</legend>

                    <div class="presets">
                        <span>Presets: </span>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-unset" value="" checked>
                            Site Default
                        </InputRadio>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-x-small" value="1.0">
                            Extra Small
                        </InputRadio>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-small" value="1.1">
                            Small
                        </InputRadio>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-medium" value="1.2">
                            Normal
                        </InputRadio>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-large" value="1.4">
                            Large
                        </InputRadio>
                        <InputRadio name="controls-line-height-preset" shouldSaveValue id="controls-line-height-preset-x-large" value="1.6">
                            Extra Large
                        </InputRadio>
                    </div>

                    <InputNumeric name="controls-line-height-custom" shouldSaveValue id="controls-line-height-custom" min="1.0" max="2.0" step="0.1">
                        By font size (em):
                    </InputNumeric>
                </fieldset>
            </div>

            <div class="controls-group controls-group-layout">
                <fieldset>
                    <legend>Layout stuffs:</legend>

                    <p>
                        On desktop view, the navigation is turned into a sidebar.
                        <br />
                        You might not want this behaviour, and you can disable it below.
                        <br />
                        <InputCheckbox name="controls-layout-force-mobile" shouldSaveValue id="controls-layout-force-mobile">
                            Force mobile layout?
                        </InputCheckbox>
                    </p>

                    <p>
                        The website has a large amount of padding on the left and right edges in order to centre the page content and direct flow.
                        <br />
                        If you would prefer not having any paddings and instead letting the content fill the entire width, you can do so below.
                        <br />
                        <InputCheckbox name="controls-layout-remove-page-padding" shouldSaveValue id="controls-layout-remove-page-padding">
                            Remove page padding?
                        </InputCheckbox>
                    </p>

                    <p>
                        In most of my writings, I manually enter linebreaks to break up long lines, targeting a specific view width.
                        <br />
                        However, this might not be ideal if you are, for example, reading on mobile. You can collapse all manual linebreaks below.
                        <br />
                        <InputCheckbox name="controls-layout-collapse-manual-linebreaks" shouldSaveValue id="controls-layout-collapse-manual-linebreaks">
                            Collapse manual linebreaks?
                        </InputCheckbox>
                    </p>

                    <p>
                        On narrower displays, the website automatically adjusts to reduce the margins on the left and right sides of sections.
                        <br />
                        However, if that isn’t enough for you, you can collapse all margins below. This also disables any borders or shadows on the sections.
                        <br />
                        <InputCheckbox name="controls-layout-collapse-margins" shouldSaveValue id="controls-layout-collapse-margins">
                            Collapse margins?
                        </InputCheckbox>
                    </p>
                </fieldset>
            </div>
        </div>
    </Details>

    {showExample && (
        <>
            <hr />
            <p>
                <i>Below is a preview for the control settings.</i>
                <br />
                <i>Note that the settings are saved as you are editing, this is simply for convenience.</i>
            </p>
            <Details summary="Example Writing">
                <div>
                    <div class="example-writing">
                        <div id="content">
                            <Section>
                                <ExampleWriting />
                            </Section>
                        </div>
                    </div>
                </div>
            </Details>
        </>
    )}
</Section>

<style>
    .presets {
        margin-block: 0.6em;
    }

    .controls {
        font-size: 0.9rem;

        padding-bottom: 1.2em;

        display: flex;
        flex-direction: row;
        gap: 1em;

        flex-wrap: wrap;
    }

    .controls-group {
        display: flex;
        flex-direction: column;
    }

    .controls-group-fonts {
        flex: 2;
    }

    .controls-group-layout {
        flex: 3.85;
    }

    @media (max-width: 750px) {
        .controls {
            gap: 0;
        }

        .controls-group {
            flex: none;
            width: 100%;
        }
    }

    .example-writing {
        overflow: auto;
        max-width: 540px;
        max-height: 350px;
        margin-block: 0.4rem;
        margin-inline: auto;
    }
</style>

<script>
    const presetChanged = (preset: HTMLInputElement, custom: HTMLInputElement, modify: (value: string) => void) => {
        if (preset.checked) {
            if (custom.value) {
                custom.value = "";
                custom.dispatchEvent(new InputEvent("change"));
            }
            window.requestAnimationFrame(() => {
                modify(preset.value);
            });
        }
    };

    const customChanged = (custom: HTMLInputElement, presets: HTMLInputElement[], defaultPreset: HTMLInputElement, modify: (value: string) => void) => {
        if (custom.value) {
            for (const preset of presets) {
                if (preset.checked) {
                    preset.checked = false;
                    preset.dispatchEvent(new InputEvent("change"));
                }
            }
            window.requestAnimationFrame(() => {
                modify(custom.value);
            });
        } else if (presets.every((e) => !e.checked)) {
            defaultPreset.checked = true;
            defaultPreset.dispatchEvent(new InputEvent("change"));
        }
    };

    const migrateOldKey = (key: string, then: (value: string) => void) => {
        const value = window.localStorage.getItem(key);
        if (value) {
            window.localStorage.removeItem(key);
            then(value);
        }
    };

    /* font family */
    document.addEventListener("DOMContentLoaded", () => {
        const content = document.getElementById("content")!;
        const presets = [...document.querySelectorAll<HTMLInputElement>(`input[name="controls-font-family-preset"]`)];
        const defaultPreset = document.getElementById(`controls-font-family-preset-unset`)! as HTMLInputElement;
        const custom = document.querySelector<HTMLInputElement>(`input[name="controls-font-family-custom"]`)!;

        const modify = (value: string) => {
            content.style.fontFamily = value;
        };

        for (const preset of presets) {
            preset.addEventListener("change", () => presetChanged(preset, custom, modify));
        }

        {
            custom.addEventListener("change", () => {
                customChanged(custom, presets, defaultPreset, modify);
            });
        }

        migrateOldKey("font-family-preset", (value) => {
            for (const preset of presets) {
                if (preset.value == value) {
                    preset.checked = true;
                    window.requestAnimationFrame(() => preset.dispatchEvent(new InputEvent("change")));
                } else {
                    preset.checked = false;
                }
            }
        });
        migrateOldKey("font-family-custom", (value) => {
            custom.value = value;
            window.requestAnimationFrame(() => custom.dispatchEvent(new InputEvent("change")));
        });
    });

    /* font size */
    document.addEventListener("DOMContentLoaded", () => {
        const content = document.getElementById("content")!;
        const presets = [...document.querySelectorAll<HTMLInputElement>(`input[name="controls-font-size-preset"]`)];
        const defaultPreset = document.getElementById(`controls-font-size-preset-unset`)! as HTMLInputElement;
        const custom = document.querySelector<HTMLInputElement>(`input[name="controls-font-size-custom"]`)!;

        for (const preset of presets) {
            const modify = (value: string) => {
                content.style.fontSize = value;

                const fontSize = window.getComputedStyle(content).fontSize.replace("px", "");
                custom.defaultValue = fontSize;
                custom.value = fontSize;
            };

            preset.addEventListener("change", () => presetChanged(preset, custom, modify));
        }

        {
            const modify = (value: string) => {
                content.style.fontSize = `${value}px`;
            };
            custom.addEventListener("change", () => {
                customChanged(custom, presets, defaultPreset, modify);
            });
        }

        migrateOldKey("font-size-preset", (value) => {
            for (const preset of presets) {
                if (preset.value == value) {
                    preset.checked = true;
                    window.requestAnimationFrame(() => preset.dispatchEvent(new InputEvent("change")));
                } else {
                    preset.checked = false;
                }
            }
        });
        migrateOldKey("font-size-pixels", (value) => {
            custom.value = value;
            window.requestAnimationFrame(() => custom.dispatchEvent(new InputEvent("change")));
        });
    });

    /* line height */
    document.addEventListener("DOMContentLoaded", () => {
        const content = document.getElementById("content")!;
        const presets = [...document.querySelectorAll<HTMLInputElement>(`input[name="controls-line-height-preset"]`)];
        const defaultPreset = document.getElementById(`controls-line-height-preset-unset`)! as HTMLInputElement;
        const custom = document.querySelector<HTMLInputElement>(`input[name="controls-line-height-custom"]`)!;

        for (const preset of presets) {
            const modify = (value: string) => {
                content.style.lineHeight = value;

                const fontSize = Number.parseFloat(window.getComputedStyle(content).fontSize.replace("px", ""));
                const lineHeight = (
                    Math.floor((100.0 * Number.parseFloat(window.getComputedStyle(content).lineHeight.replace("px", ""))) / fontSize) / 100.0
                ).toString();
                custom.defaultValue = lineHeight;
                custom.value = lineHeight;
            };

            preset.addEventListener("change", () => presetChanged(preset, custom, modify));
        }

        {
            const modify = (value: string) => {
                content.style.lineHeight = value;
            };
            custom.addEventListener("change", () => {
                customChanged(custom, presets, defaultPreset, modify);
            });
        }

        migrateOldKey("line-height-preset", (value) => {
            for (const preset of presets) {
                if (preset.value == value) {
                    preset.checked = true;
                    window.requestAnimationFrame(() => preset.dispatchEvent(new InputEvent("change")));
                } else {
                    preset.checked = false;
                }
            }
        });
        migrateOldKey("line-height-em", (value) => {
            custom.value = value;
            window.requestAnimationFrame(() => custom.dispatchEvent(new InputEvent("change")));
        });
    });

    /* layout stuffs */
    document.addEventListener("DOMContentLoaded", () => {
        const content = document.getElementById("content")!;

        {
            const e = document.getElementById("controls-layout-collapse-manual-linebreaks")! as HTMLInputElement;
            e.addEventListener("change", () => {
                content.dataset.collapseManualLinebreaks = e.checked.toString();
            });
            migrateOldKey("collapse-manual-linebreaks", (value) => {
                e.checked = value == "true";
                window.requestAnimationFrame(() => e.dispatchEvent(new InputEvent("change")));
            });
        }
        {
            const e = document.getElementById("controls-layout-force-mobile")! as HTMLInputElement;
            e.addEventListener("change", () => {
                document.body.dataset.forceMobile = e.checked.toString();
            });
            migrateOldKey("force-mobile", (value) => {
                e.checked = value == "true";
                window.requestAnimationFrame(() => e.dispatchEvent(new InputEvent("change")));
            });
        }
        {
            const e = document.getElementById("controls-layout-remove-page-padding")! as HTMLInputElement;
            e.addEventListener("change", () => {
                document.body.dataset.removePagePadding = e.checked.toString();
            });
            migrateOldKey("remove-page-padding", (value) => {
                e.checked = value == "true";
                window.requestAnimationFrame(() => e.dispatchEvent(new InputEvent("change")));
            });
        }
        {
            const e = document.getElementById("controls-layout-collapse-margins")! as HTMLInputElement;
            e.addEventListener("change", () => {
                document.body.dataset.collapseMargins = e.checked.toString();
            });
            migrateOldKey("collapse-margins", (value) => {
                e.checked = value == "true";
                window.requestAnimationFrame(() => e.dispatchEvent(new InputEvent("change")));
            });
        }
    });
</script>
