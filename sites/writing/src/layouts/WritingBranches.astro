---
import { normalizeHtml, renderMd } from "@sqky-one/writing/lib/content";
import { experimental_AstroContainer } from "astro/container";
import parse, { HTMLElement } from "node-html-parser";

import { type Element, type Tangent } from "./branch";
import BranchElement from "./branch/Branch.astro";
import BranchesElement from "./branch/Branches.astro";

const container = await experimental_AstroContainer.create();

const content = await Astro.slots.render("default");
const parsedContent = parse(normalizeHtml(content));

async function renderMdText(text: string | undefined) {
    const parsed = parse(await renderMd(text?.trim()));
    if (!parsed.firstChild) return "";

    return parsed.firstChild.childNodes.join("");
}

async function parseTangent(element: HTMLElement, branchName: string, index: number): Promise<Tangent> {
    return {
        type: "tangent",
        name: `${branchName}-tangent-${index}`,
        class: element.getAttribute("class") ?? "",
        required: !(element.getAttribute("optional") != undefined),
        data: {
            text: await renderMdText(element.getAttribute("text")),
            content: element.children.join(""),
            attributes: (() => {
                element.removeAttribute("class");
                element.removeAttribute("text");
                element.removeAttribute("optional");
                return element.attributes;
            })(),
        },
    };
}

const flags = new Set();
const elements: Element[] = [{ type: "root", name: "root" }];

const defaultCounts = { tangent: 1 };
let currentParentName = elements[0].name;
let counts = { ...defaultCounts };
for (const element of parsedContent.children) {
    Object.keys(element.attributes)
        .filter((k) => k.startsWith("data-astro"))
        .forEach((k) => element.removeAttribute(k));

    const type = element.rawTagName;
    if (type == "branch") {
        const choices = [];
        const tangents: string[] = [];
        if (!element.getAttribute("name")) {
            throw Error("branch needs to have a `name` set!");
        }
        const name = `branch-${element.getAttribute("name")}`;
        element.removeAttribute("name");
        const clazz = element.getAttribute("class") ?? "";
        element.removeAttribute("class");

        for (const child of element.children) {
            if (child.rawTagName == "choice") {
                const text = await renderMdText(child.getAttribute("text"));
                if (!text) {
                    throw Error("choice needs to have a `text` set!");
                }

                const choice = {
                    text,
                    content: "",
                    flags: child.getAttribute("flag")?.split(" ") ?? [],
                    attributes: (() => {
                        child.removeAttribute("flag");
                        child.removeAttribute("text");
                        return child.attributes;
                    })(),
                };
                currentParentName = `${name}-${choices.length + 1}`;
                counts = { ...defaultCounts };

                for (const inner of child.children) {
                    if (inner.rawTagName == "tangent") {
                        const tangent = await parseTangent(inner, currentParentName, counts.tangent);
                        tangents.push(tangent.name);
                        counts.tangent += 1;

                        choice.content += await container.renderToString(BranchElement, { props: { element: tangent } });
                    } else {
                        choice.content += inner.toString();
                    }
                }

                for (const flag of choice.flags) {
                    flags.add(flag);
                }

                choices.push(choice);
            }
        }

        elements.push({
            type,
            name,
            class: clazz,
            data: {
                choices,
            },
            attributes: element.attributes,
        });
        currentParentName = name;
        counts = { ...defaultCounts };
    } else if (type == "continue") {
        const name = `${currentParentName}-continue`;
        const clazz = element.getAttribute("class") ?? "";
        element.removeAttribute("class");
        const text = element.innerText;
        elements.push({
            type,
            name,
            class: clazz,
            data: {
                text: (text === "true" ? undefined : await renderMdText(text)) || "Continue",
            },
        });
        currentParentName = name;
        counts = { ...defaultCounts };
    } else if (type == "tangent") {
        // set optional by default for freestanding tangents
        if (element.getAttribute("optional") == undefined) {
            element.setAttribute("optional", "");
        }
        elements.push(await parseTangent(element, currentParentName, counts.tangent));
        counts.tangent += 1;
    } else {
        elements.push({
            type: "raw",
            name: `${currentParentName}-content`,
            data: {
                html: element.toString(),
            },
        });
    }
}

const flagsCss = [
    "#content .show-with-flag { display: none; }",
    ...flags.values().map((flag) => {
        return `
#content:has(input[data-flag~="${flag}"]:checked) .show-with-flag[data-flag~="${flag}"] { display: unset; }
#content:has(input[data-flag~="${flag}"]:checked) .hide-with-flag[data-flag~="${flag}"] { display: none; }`;
    }),
];
---

<div class="writings-branches">
    <BranchesElement elements={elements} />
</div>

<style is:global lang="scss">
    .writings-branches {
        .choices,
        .check {
            input:focus-visible {
                all: unset;
            }

            label {
                display: inline-block;
                font-family: var(--mono);
                text-decoration: none;
                color: var(--buttonTextColor);

                user-select: none;
                cursor: pointer;

                padding-block: 0.25em;
                padding-inline: 0.2em;
                border-radius: 0.3em;

                background-color: var(--buttonBgColor);
                border: 2px solid var(--buttonBorderColor);
            }

            label:hover,
            label:has(> input:focus-visible) {
                color: var(--buttonHoverTextColor);
                background-color: var(--buttonHoverBgColor);
                border-color: var(--buttonHoverBorderColor);
            }

            label:has(> input:focus-visible) {
                outline: 2px solid var(--focusColor);
            }

            label:has(> input:checked) {
                color: var(--buttonActiveTextColor);
                background-color: var(--buttonActiveBgColor);
                border-color: var(--buttonActiveBorderColor);

                text-decoration: underline;
                text-underline-offset: 15%;
            }
        }

        .choices {
            display: flex;
            border: 1px solid var(--separatorColor);

            font-size: 0.8em;
            margin-bottom: 0.2em;
            padding-inline: 0.75em;
            padding-block: 1em;

            gap: 0.6em;
            flex-wrap: wrap;
        }

        .choices > * {
            flex: none;
            max-width: 40%;
            height: fit-content;
        }

        .branches > *,
        .branches + * {
            display: none;
        }

        @for $i from 1 through 32 {
            .writings-branch
                > .choices:has(input[type="radio"][value="#{$i}"]:checked) /* select the one that's checked */
                ~ .branches /* go to branches */
                    > :nth-child(#{$i}) /* unhide the one with the same index as the choice value */ {
                display: block;
                animation: fade-in 0.15s ease-in;
            }

            .writings-branch
                > .choices:has(input[type="radio"][value="#{$i}"]:checked) /* select the one that's checked */
                ~ .branches:not(:has(
                    > :nth-child(#{$i}) /* go to the corresponding branch */
                        .tangent[data-required="true"] input:not(:checked) /* check that the branch doesn't have any unchecked tangents */
                ))
                + * /* unhide if either there's no tangents, or all tangents are checked */ {
                display: block;
                animation: fade-in 0.15s ease-in;
            }
        }

        .check {
            margin-block: 1.1em;
        }

        .check[data-required="true"]::before {
            content: "↳" / "" !important;
            color: var(--focusColor);
        }

        .check:not([data-required="true"])::before {
            content: "⋯" / "" !important;
            color: var(--linkColor);
        }

        .check::before {
            display: inline-block;

            font-size: 1.2em;
            font-family: var(--sans);

            margin-left: 0.25em;
            margin-right: 0.5em;
            padding-top: 0.2rlh;
            vertical-align: top;
        }

        .check {
            text-wrap: nowrap;
        }

        .check > label {
            text-wrap: wrap;
        }

        .check > label:has(> input:not(:checked)) + * {
            display: none;
        }

        .check[data-required="true"]:has(> label > input:not(:checked)) ~ * {
            display: none;
        }

        .check > label:has(> input:checked) + *,
        .check[data-required="true"]:has(> label > input:checked) ~ * {
            animation: fade-in 0.15s ease-in;
        }

        @media (prefers-reduced-motion) {
            * {
                animation: none !important;
            }
        }
    }
</style>

<style is:raw set:text={flagsCss}></style>
