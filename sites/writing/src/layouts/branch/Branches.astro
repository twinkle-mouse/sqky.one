---
import { experimental_AstroContainer } from "astro/container";

import { type Element } from ".";
import Branch from "./Branch.astro";

const container = await experimental_AstroContainer.create();

export type Props = {
    elements: Element[];
};

const { elements } = Astro.props;
let rendered = "";

if (elements) {
    for (let i = elements.length - 1; i >= 0; i--) {
        const element = elements[i];
        const child = await container.renderToString(Branch, { props: { element, index: i }, slots: { default: rendered } });
        rendered = child;
    }
}
---

<Fragment set:html={rendered} />
