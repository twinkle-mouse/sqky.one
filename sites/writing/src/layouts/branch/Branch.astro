---
import { type Element } from ".";

export type Props = {
    element: Element;
};

const { element } = Astro.props;
---

<>
    {(() => {
        if (element.type == "root") {
            return <slot />;
        } else if (element.type == "branch") {
            return (
                <div class:list={["writing-branch", element.class]} {...element.attributes}>
                    <ol class="choices">
                        {element.data.choices.map((choice, idx) => {
                            return (
                                <li>
                                    <label {...choice.attributes} for={`${element.name}-${idx + 1}`}>
                                        <Fragment set:html={choice.text} />
                                        <input
                                            id={`${element.name}-${idx + 1}`}
                                            type="radio"
                                            name={element.name}
                                            value={`${idx + 1}`}
                                            data-flag={choice.flags.join(" ")}
                                        />
                                    </label>
                                </li>
                            );
                        })}
                    </ol>
                    <div class="branches">
                        {element.data.choices.map((choice) => {
                            return <div set:html={choice.content} hidden={choice.content == ""} />;
                        })}
                    </div>

                    <slot />
                </div>
            );
        } else if (element.type == "continue") {
            return (
                <div class:list={["check continue", element.class]} data-required="true">
                    <label for={element.name}>
                        {element.data.text}
                        <input id={element.name} type="checkbox" name={element.name} />
                    </label>

                    <div>
                        <slot />
                    </div>
                </div>
            );
        } else if (element.type == "tangent") {
            return (
                <>
                    <div class:list={["check tangent", element.class]} data-required={element.required ? "true" : undefined} {...element.data.attributes}>
                        <label for={element.name}>
                            {!element.required && <span class="sr-only">Optional text: </span>}
                            {element.data.text}
                            <input id={element.name} type="checkbox" name={element.name} />
                        </label>

                        <div set:html={element.data.content} />
                    </div>

                    <slot />
                </>
            );
        } else if (element.type == "raw") {
            return (
                <>
                    <Fragment set:html={element.data.html} />

                    <slot />
                </>
            );
        }
    })()}
</>
