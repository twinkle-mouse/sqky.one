---
import InputCheckbox from "@sqky-one/common/components/InputCheckbox.astro";
import InputRadio from "@sqky-one/common/components/InputRadio.astro";

import { type Element } from ".";

export type Props = {
    element: Element;
    writingId: string;
};

const { element, writingId } = Astro.props;

if (element === undefined || writingId === undefined) {
    throw Error("Missing props in Branch!");
}
---

{element.type == "branch" && (
    <div class:list={["branch-element writing-branch", element.class]} {...element.attributes}>
        <ol class="choices">
            {element.data.choices.map((choice, idx) => {
                return (
                    <li>
                        <InputRadio
                            labelProps={choice.attributes}
                            id={`${element.name}-${idx + 1}`}
                            name={`${writingId}_${element.name}`}
                            shouldSaveValue
                            value={`${idx + 1}`}
                            data-flag={choice.flags.join(" ")}
                            iconName={undefined}
                        >
                            <Fragment set:html={choice.text} />
                        </InputRadio>
                    </li>
                );
            })}
        </ol>
        <div class="branches">
            {element.data.choices.map((choice) => {
                return <div class="slot" set:html={choice.content} hidden={choice.content == ""} />;
            })}
        </div>

        <div class="slot">
            <slot />
        </div>
    </div>
)}
{element.type == "continue" && (
    <div class:list={["branch-element writing-check continue", element.class]} data-required="true">
        {element.data.content && <div set:html={element.data.content} />}

        <div class="check">
            <InputCheckbox id={element.name} name={`${writingId}_${element.name}`} shouldSaveValue iconName={undefined}>
                <Fragment set:html={element.data.text} />
            </InputCheckbox>
        </div>

        <div class="slot">
            <slot />
        </div>
    </div>
)}
{element.type == "tangent" && (
    <>
        <div
            class:list={["branch-element writing-check tangent", element.class]}
            data-required={element.required ? "true" : undefined}
            {...element.data.attributes}
        >
            <div class="check">
                <InputCheckbox id={element.name} name={`${writingId}_${element.name}`} shouldSaveValue iconName={undefined}>
                    <>
                        {!element.required && <span class="sr-only">Optional text: </span>}
                        <Fragment set:html={element.data.text} />
                    </>
                </InputCheckbox>
            </div>

            <div class="slot" set:html={element.data.content} />
        </div>

        <slot />
    </>
)}
