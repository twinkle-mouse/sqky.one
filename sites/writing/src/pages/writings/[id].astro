---
import FileIcon from "@sqky-one/common/components/FileIcon.astro";
import Picture from "@sqky-one/common/components/Picture.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import AO3Icon from "@sqky-one/writing/components/AO3Icon.astro";
import RssIcon from "@sqky-one/writing/components/RssIcon.astro";
import WritingDetails from "@sqky-one/writing/components/WritingDetails.astro";
import WritingContent from "@sqky-one/writing/layouts/WritingContent.astro";
import WritingControls from "@sqky-one/writing/layouts/WritingControls.astro";
import WritingPage from "@sqky-one/writing/layouts/WritingPage.astro";
import { coverArtAlt, getWritingEntries, htmlToTextContent, renderWritingFrontmatterMd } from "@sqky-one/writing/lib/content";
import { getEntry, render } from "astro:content";
import * as mime from "mrmime";

export async function getStaticPaths() {
    return (await getWritingEntries()).map((entry) => {
        return { params: { id: entry.id } };
    });
}

const { id } = Astro.params;
const entry = await getEntry("writings", id);
if (entry === undefined) {
    return Astro.redirect("/404");
}
if (entry.data.redirect) {
    return Astro.redirect(entry.data.redirect);
}
renderWritingFrontmatterMd(entry);

const renderResult = await render(entry);
const { headings } = renderResult;
const desc = htmlToTextContent(entry.data.description).replaceAll("\n\n", " — ").replaceAll("\n", " ");
---

<WritingPage pageName={`'${entry.data.title}'`} desc={desc}>
    <Fragment slot="head-tags">
        {entry.data.thumbnail && (
            <Fragment>
                <meta property="og:image" content={new URL(entry.data.thumbnail.src, import.meta.env.SITE)} />
                <meta property="og:image:type" content={mime.lookup(entry.data.thumbnail.format ?? entry.data.thumbnail.src)} />
                <meta property="og:image:width" content={entry.data.thumbnail.width.toString()} />
                <meta property="og:image:height" content={entry.data.thumbnail.height.toString()} />
                <meta property="og:image:alt" content={coverArtAlt(entry)} />

                <meta name="twitter:card" content="summary_large_image" />
            </Fragment>
        )}
    </Fragment>

    <Fragment slot="nav:page-links">
        {headings.map((v) => (
            <li>
                <a href={`#${v.slug}`}>{v.text}</a>
            </li>
        ))}
    </Fragment>

    <Fragment slot="page-title">{entry.data.title}</Fragment>

    <Section>
        <h2>
            <i>Other Formats</i>
        </h2>
        <ul class="formats-list">
            {!entry.data.web && (
                <li>
                    <FileIcon icon="epub" />
                    <a href=`/writings/${entry.id}.epub`>EPub</a>
                </li>
            )}
            <li>
                <RssIcon />
                <a href="/rss.xml">RSS (entire feed)</a>
            </li>
            {entry.data.ao3 && (
                <li>
                    <AO3Icon />
                    <a href={`https://archiveofourown.org/works/${entry.data.ao3}`}>
                        <abbr title="Archive of Our Own">AO3</abbr>
                    </a>
                </li>
            )}
        </ul>

        <style>
            .formats-list {
                margin-top: 1.3em;
                margin-bottom: 1em;
            }

            .formats-list > li {
                margin-block: 0.25em;
            }
        </style>
    </Section>

    <div class="top-panel">
        <Section class="info">
            <h2>
                <i>Information</i>
            </h2>

            <WritingDetails entry={entry} />
        </Section>

        {entry.data.cover && <Picture class="cover-art-img" src={entry.data.cover} alt={coverArtAlt(entry)} pictureAttributes={{ class: "cover-art" }} />}
    </div>

    <style>
        .top-panel {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;

            gap: 0.5rem;
        }

        .cover-art {
            flex: 1;
            max-width: 330px;

            margin-right: 1rem;
            margin-block: 1.5rem;

            --responsive-padding: calc(min(max(50% - 300px, 0.05rem), 40%));
        }

        .cover-art-img {
            height: fit-content;

            box-shadow:
                -8px -8px 8px #00000030,
                -8px 8px 8px #00000030,
                8px -8px 8px #00000030,
                8px 8px 8px #00000030,
                0px 0px 8px #00000060;
        }

        .info {
            flex: 2 1;
            height: fit-content;
        }

        @media (max-width: 900px) {
            .cover-art {
                margin: 0;

                padding-inline: var(--responsive-padding);

                min-width: 100%;
                padding-block: 1rem !important;
                margin-bottom: 0.75rem !important;
            }
        }

        @media (max-width: 640px) {
            .cover-art {
                padding-block: 0.5rem !important;
            }
        }

        body[data-force-mobile="true"] {
            .cover-art {
                margin: 0;

                padding-inline: var(--responsive-padding);

                min-width: 100%;
                padding-block: 1rem;
                margin-bottom: 0.5rem;
            }
        }
    </style>

    <WritingControls />

    <WritingContent renderResult={renderResult} />
</WritingPage>
