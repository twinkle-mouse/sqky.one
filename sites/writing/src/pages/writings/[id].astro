---
import Checkbox from "@sqky-one/common/components/Checkbox.astro";
import Details from "@sqky-one/common/components/Details.astro";
import FileIcon from "@sqky-one/common/components/FileIcon.astro";
import NumericInput from "@sqky-one/common/components/NumericInput.astro";
import Picture from "@sqky-one/common/components/Picture.astro";
import RadioInput from "@sqky-one/common/components/RadioInput.astro";
import TextInput from "@sqky-one/common/components/TextInput.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import AO3Icon from "@sqky-one/writing/components/AO3Icon.astro";
import RssIcon from "@sqky-one/writing/components/RssIcon.astro";
import WritingDetails from "@sqky-one/writing/components/WritingDetails.astro";
import WritingsContent from "@sqky-one/writing/layouts/WritingsContent.astro";
import WritingsPage from "@sqky-one/writing/layouts/WritingsPage.astro";
import { coverArtAlt, getWritingEntries, htmlToTextContent, renderWritingFrontmatterMd } from "@sqky-one/writing/lib/content";
import { getEntry, render } from "astro:content";
import * as mime from "mrmime";

export async function getStaticPaths() {
    return (await getWritingEntries()).map((entry) => {
        return { params: { id: entry.id } };
    });
}

const { id } = Astro.params;
const entry = await getEntry("writings", id);
if (entry === undefined) {
    return Astro.redirect("/404");
}
if (entry.data.redirect) {
    return Astro.redirect(entry.data.redirect);
}
renderWritingFrontmatterMd(entry);

const renderResult = await render(entry);
const { headings } = renderResult;
const desc = htmlToTextContent(entry.data.description).replaceAll("\n", " ").replaceAll("   ", " - ");
---

<WritingsPage pageName={`'${entry.data.title}'`} desc={desc}>
    <Fragment slot="head-tags">
        {
            entry.data.thumbnail && (
                <Fragment>
                    <meta property="og:image" content={new URL(entry.data.thumbnail.src, import.meta.env.SITE)} />
                    <meta property="og:image:type" content={mime.lookup(entry.data.thumbnail.format ?? entry.data.thumbnail.src)} />
                    <meta property="og:image:width" content={entry.data.thumbnail.width.toString()} />
                    <meta property="og:image:height" content={entry.data.thumbnail.height.toString()} />
                    <meta property="og:image:alt" content={coverArtAlt(entry)} />

                    <meta name="twitter:card" content="summary_large_image" />
                </Fragment>
            )
        }
    </Fragment>

    <Fragment slot="nav:page-links">
        {
            headings.map((v) => (
                <li>
                    <a href={`#${v.slug}`}>{v.text}</a>
                </li>
            ))
        }
    </Fragment>

    <Fragment slot="page-title">{entry.data.title}</Fragment>

    <Section>
        <h2>Other Formats</h2>
        <ul class="formats-list">
            <li>
                <FileIcon icon="epub" />
                <a href=`/writings/${entry.id}.epub`>EPub version</a>
            </li>
            <li>
                <RssIcon />
                <a href="/rss.xml">RSS (entire feed)</a>
            </li>
            {
                entry.data.ao3 && (
                    <li>
                        <AO3Icon />
                        <a href={`https://archiveofourown.org/works/${entry.data.ao3}`}>
                            <abbr title="Archive of Our Own">AO3</abbr>
                        </a>
                    </li>
                )
            }
        </ul>

        <style>
            .formats-list {
                margin-top: 1.3em;
                margin-bottom: 1em;
            }

            .formats-list > li {
                margin-block: 0.25em;
            }
        </style>
    </Section>

    <div class="top-panel">
        <Section class="info">
            <h2><i>Information</i></h2>

            <WritingDetails entry={entry} />
        </Section>

        {entry.data.cover && <Picture class="cover-art-img" src={entry.data.cover} alt={coverArtAlt(entry)} pictureAttributes={{ class: "cover-art" }} />}
    </div>

    <style>
        .top-panel {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;

            gap: 0.5rem;
        }

        .cover-art {
            flex: 1;
            max-width: 330px;

            margin-right: 1rem;
            margin-block: 1.5rem;

            --responsive-padding: calc(min(max(50% - 300px, 0.05rem), 40%));
        }

        .cover-art-img {
            height: fit-content;

            box-shadow:
                -8px -8px 8px #00000030,
                -8px 8px 8px #00000030,
                8px -8px 8px #00000030,
                8px 8px 8px #00000030,
                0px 0px 8px #00000060;
        }

        .info {
            flex: 2 1;
            height: fit-content;
        }

        @media (max-width: 900px) {
            .cover-art {
                margin: 0;

                padding-inline: var(--responsive-padding);

                min-width: 100%;
                padding-block: 1rem !important;
                margin-bottom: 0.75rem !important;
            }
        }

        @media (max-width: 640px) {
            .cover-art {
                padding-block: 0.5rem !important;
            }
        }

        body[data-force-mobile="true"] {
            .cover-art {
                margin: 0;

                padding-inline: var(--responsive-padding);

                min-width: 100%;
                padding-block: 1rem;
                margin-bottom: 0.5rem;
            }
        }
    </style>

    <Section class="controls js-necessary">
        <h2>Controls</h2>

        <p>
            <i>Below is a few inputs for controlling the visuals of the writing.</i><br />
            <i>Any values changed here will be saved to your browser for reuse across all writings on the Stardew Library.</i>
        </p>

        <Details summary="Display Controls">
            <div class="controls">
                <fieldset>
                    <legend>Font family:</legend>

                    <div>
                        <label>Presets:</label>
                        <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-unset" value="">Site Default</RadioInput>
                        <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-ibm-plex-sans" value="var(--font-ibm-plex-sans)"
                            >IBM Plex Sans</RadioInput
                        >
                        <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-inter" value="var(--font-inter)">Inter</RadioInput>
                        <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-noto-sans" value="var(--font-noto-sans)"
                            >Noto Sans</RadioInput
                        >
                        <RadioInput name="controls-font-family-preset" id="controls-font-family-preset-roboto" value="var(--font-roboto)">Roboto</RadioInput>
                    </div>

                    <div>
                        <TextInput id="controls-font-family-custom">Custom font:</TextInput>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Font size:</legend>

                    <div>
                        <label>Presets:</label>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-unset" value="">Site Default</RadioInput>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-x-small" value="x-small">Extra Small</RadioInput>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-small" value="small">Small</RadioInput>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-medium" value="medium">Normal</RadioInput>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-large" value="large">Large</RadioInput>
                        <RadioInput name="controls-font-size-preset" id="controls-font-size-preset-x-large" value="x-large">Extra Large</RadioInput>
                    </div>

                    <div>
                        <NumericInput id="controls-font-size-pixels" min="12" max="28">Pixel value:</NumericInput>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Line height:</legend>

                    <div>
                        <label>Presets:</label>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-unset" value="">Site Default</RadioInput>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-x-small" value="1.0">Extra Small</RadioInput>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-small" value="1.1">Small</RadioInput>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-medium" value="1.2">Normal</RadioInput>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-large" value="1.4">Large</RadioInput>
                        <RadioInput name="controls-line-height-preset" id="controls-line-height-preset-x-large" value="1.6">Extra Large</RadioInput>
                    </div>

                    <div>
                        <NumericInput id="controls-line-height-em" min="1.0" max="2.0" step="0.1">By font size (em):</NumericInput>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Layout stuffs:</legend>

                    <p>
                        On desktop view, the navigation is turned into a sidebar.<br />
                        You might not want this behaviour, and you can disable it below.
                        <br />
                        <Checkbox id="controls-layout-force-mobile">Force mobile layout?</Checkbox>
                    </p>

                    <p>
                        The website has a large amount of padding on the left and right edges in order to centre the page content and direct flow.<br />
                        If you would prefer not having any paddings and instead letting the content fill the entire width, you can do so below.
                        <br />
                        <Checkbox id="controls-layout-remove-page-padding">Remove page padding?</Checkbox>
                    </p>

                    <p>
                        On narrower displays, the website automatically adjusts to reduce the margins on the left and right sides of sections.<br />
                        However, that might not be enough for you, or you just do not want any margins whatsoever.<br />
                        If so, you can collapse all margins below; this also disables any kinds of borders or shadows on the sections.
                        <br />
                        <Checkbox id="controls-layout-collapse-margins">Collapse margins?</Checkbox>
                    </p>
                </fieldset>
            </div>

            <style>
                .controls {
                    padding-bottom: 1.4rem;
                }
            </style>
        </Details>
    </Section>

    <WritingsContent renderResult={renderResult}>
        <script>
            const content = document.getElementById("content")!;

            const fontFamilyCustom = {
                key: "font-family-custom",
                element: document.getElementById("controls-font-family-custom")! as HTMLInputElement,

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.fontFamily = "";
                    } else {
                        content.style.fontFamily = value;
                    }

                    for (const e of fontSizePreset.elements) {
                        e.checked = false;
                    }
                    fontSizePreset.clear();
                },
            };

            const fontSizePreset = {
                key: "font-family-preset",
                elements: [
                    "controls-font-family-preset-unset",
                    "controls-font-family-preset-ibm-plex-sans",
                    "controls-font-family-preset-inter",
                    "controls-font-family-preset-noto-sans",
                    "controls-font-family-preset-roboto",
                ].map((id) => document.getElementById(id)! as HTMLInputElement),

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.fontFamily = "";
                    } else {
                        content.style.fontFamily = value;
                    }

                    fontFamilyCustom.clear();
                },
            };

            {
                const custom = fontFamilyCustom.get();
                const preset = fontSizePreset.get();

                if (custom) {
                    fontFamilyCustom.element.value = custom;
                    fontFamilyCustom.set(custom);
                } else if (preset) {
                    fontSizePreset.set(preset);
                } else {
                    fontSizePreset.set("");
                }
            }

            {
                fontFamilyCustom.element.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        fontFamilyCustom.set(target.value || target.defaultValue);
                    }
                });
            }

            for (const e of fontSizePreset.elements) {
                const current = fontSizePreset.get();
                if (current === e.value) {
                    e.checked = true;
                } else {
                    e.checked = false;
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        fontSizePreset.set(target.value);
                    }
                });
            }
        </script>

        <script>
            const content = document.getElementById("content")!;

            function presetFontSizeChanged() {
                const fontSize = window.getComputedStyle(content).fontSize.replace("px", "");

                fontSizePixels.element.defaultValue = fontSize;
                fontSizePixels.element.value = fontSize;
            }

            const fontSizePixels = {
                key: "font-size-pixels",
                element: document.getElementById("controls-font-size-pixels")! as HTMLInputElement,

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.fontSize = "";
                    } else {
                        content.style.fontSize = `${value}px`;
                    }

                    for (const e of fontSizePreset.elements) {
                        e.checked = false;
                    }
                    fontSizePreset.clear();
                },
            };

            const fontSizePreset = {
                key: "font-size-preset",
                elements: [
                    "controls-font-size-preset-unset",
                    "controls-font-size-preset-x-small",
                    "controls-font-size-preset-small",
                    "controls-font-size-preset-medium",
                    "controls-font-size-preset-large",
                    "controls-font-size-preset-x-large",
                ].map((id) => document.getElementById(id)! as HTMLInputElement),

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.fontSize = "";
                    } else {
                        content.style.fontSize = value;
                    }

                    fontSizePixels.clear();
                    presetFontSizeChanged();
                },
            };

            {
                const pixels = fontSizePixels.get();
                const preset = fontSizePreset.get();

                if (pixels) {
                    fontSizePixels.element.value = pixels;
                    fontSizePixels.set(pixels);
                } else if (preset) {
                    fontSizePreset.set(preset);
                } else {
                    fontSizePreset.set("");
                }
            }

            {
                fontSizePixels.element.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        fontSizePixels.set(target.value || target.defaultValue);
                    }
                });
            }

            for (const e of fontSizePreset.elements) {
                const current = fontSizePreset.get();
                if (current === e.value) {
                    e.checked = true;
                } else {
                    e.checked = false;
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        fontSizePreset.set(target.value);
                    }
                });
            }
        </script>

        <script>
            const content = document.getElementById("content")!;

            function presetLineHeightChanged() {
                const fontSize = Number.parseFloat(window.getComputedStyle(content).fontSize.replace("px", ""));
                const lineHeight = (
                    Math.floor((100.0 * Number.parseFloat(window.getComputedStyle(content).lineHeight.replace("px", ""))) / fontSize) / 100.0
                ).toString();
                lineHeightEm.element.defaultValue = lineHeight;
                lineHeightEm.element.value = lineHeight;
            }

            const lineHeightEm = {
                key: "line-height-em",
                element: document.getElementById("controls-line-height-em")! as HTMLInputElement,

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.lineHeight = "";
                    } else {
                        content.style.lineHeight = value;
                    }

                    for (const e of lineHeightPreset.elements) {
                        e.checked = false;
                    }
                    lineHeightPreset.clear();
                },
            };

            const lineHeightPreset = {
                key: "line-height-preset",
                elements: [
                    "controls-line-height-preset-unset",
                    "controls-line-height-preset-x-small",
                    "controls-line-height-preset-small",
                    "controls-line-height-preset-medium",
                    "controls-line-height-preset-large",
                    "controls-line-height-preset-x-large",
                ].map((id) => document.getElementById(id)! as HTMLInputElement),

                get() {
                    try {
                        return window.localStorage.getItem(this.key);
                    } catch {
                        return null;
                    }
                },

                clear() {
                    try {
                        window.localStorage.removeItem(this.key);
                    } catch {
                        // ignore
                    }
                },

                set(value: string | null) {
                    // don't want to compare it as a number like "0"
                    const isNullish = value === null || value === "";

                    try {
                        if (isNullish) {
                            window.localStorage.setItem(this.key, "");
                        } else {
                            window.localStorage.setItem(this.key, value);
                        }
                    } catch {
                        // ignore
                    }

                    if (isNullish) {
                        content.style.lineHeight = "";
                    } else {
                        content.style.lineHeight = value;
                    }

                    lineHeightEm.clear();
                    presetLineHeightChanged();
                },
            };

            {
                const em = lineHeightEm.get();
                const preset = lineHeightPreset.get();

                if (em) {
                    lineHeightEm.element.value = em;
                    lineHeightEm.set(em);
                } else if (preset) {
                    lineHeightPreset.set(preset);
                } else {
                    lineHeightPreset.set("");
                }
            }

            {
                lineHeightEm.element.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        lineHeightEm.set(target.value || target.defaultValue);
                    }
                });
            }

            for (const e of lineHeightPreset.elements) {
                const current = lineHeightPreset.get();
                if (current === e.value) {
                    e.checked = true;
                } else {
                    e.checked = false;
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        lineHeightPreset.set(target.value);
                    }
                });
            }
        </script>

        <script>
            {
                const e = document.getElementById("controls-layout-force-mobile")! as HTMLInputElement;
                const key = "force-mobile";

                function set(checked: boolean) {
                    if (checked) {
                        window.localStorage.setItem(key, "true");
                    } else {
                        window.localStorage.removeItem(key);
                    }

                    document.body.dataset.forceMobile = checked.toString();
                }

                try {
                    e.checked = window.localStorage.getItem(key) == "true" || false;
                    set(e.checked);
                } catch {
                    // ignore
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        set(target.checked);
                    }
                });
            }

            {
                const e = document.getElementById("controls-layout-remove-page-padding")! as HTMLInputElement;
                const key = "remove-page-padding";

                function set(checked: boolean) {
                    if (checked) {
                        window.localStorage.setItem(key, "true");
                    } else {
                        window.localStorage.removeItem(key);
                    }

                    document.body.dataset.removePagePadding = checked.toString();
                }

                try {
                    e.checked = window.localStorage.getItem(key) == "true" || false;
                    set(e.checked);
                } catch {
                    // ignore
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        set(target.checked);
                    }
                });
            }

            {
                const e = document.getElementById("controls-layout-collapse-margins")! as HTMLInputElement;
                const key = "collapse-margins";

                function set(checked: boolean) {
                    if (checked) {
                        window.localStorage.setItem(key, "true");
                    } else {
                        window.localStorage.removeItem(key);
                    }

                    document.body.dataset.collapseMargins = checked.toString();
                }

                try {
                    e.checked = window.localStorage.getItem(key) == "true" || false;
                    set(e.checked);
                } catch {
                    // ignore
                }

                e.addEventListener("input", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement) {
                        set(target.checked);
                    }
                });
            }
        </script>
    </WritingsContent>
</WritingsPage>
