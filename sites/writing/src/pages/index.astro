---
import Details from "@sqky-one/common/components/Details.astro";
import EmojiWrapper from "@sqky-one/common/components/EmojiWrapper.astro";
import SearchInput from "@sqky-one/common/components/SearchInput.astro";
import LargeSection from "@sqky-one/common/layouts/LargeSection.astro";
import Section from "@sqky-one/common/layouts/Section.astro";
import RssIcon from "@sqky-one/writing/components/RssIcon.astro";
import Welcome from "@sqky-one/writing/components/Welcome.mdx";
import WritingEntries from "@sqky-one/writing/components/WritingEntries.astro";
import WritingControls from "@sqky-one/writing/layouts/WritingControls.astro";
import WritingPage from "@sqky-one/writing/layouts/WritingPage.astro";
import { getAllTags, getValidWritingEntires } from "@sqky-one/writing/lib/content";
import { siteDesc } from "@sqky-one/writing/lib/page";

const entries = await getValidWritingEntires();
const tags = await getAllTags();
---

<WritingPage pageName="Home" desc={siteDesc}>
    <Fragment slot="page-title">Stardew Library</Fragment>

    <LargeSection>
        <p class="icons">
            <a href="/rss.xml">
                <RssIcon data-glow="true" />
                Subscribe to RSS
            </a>
        </p>
        <style>
            .icons {
                padding-inline: 1.5rem;
                font-size: 1.5rem;
            }

            .icons > a {
                display: inline-block;
            }
        </style>

        <Section>
            <EmojiWrapper>
                <Welcome />
            </EmojiWrapper>
        </Section>

        <Section>
            <h2>
                <i>Entry Filters</i>
            </h2>

            <p>
                <i>Entries are tagged to the best of my organisation. You can filter the entries by their tags in the menu below.</i>
                <br />
                <i>If you have any suggestions for tags, please let me know!</i>
            </p>

            <Details summary="List of all tags">
                <div>
                    <div class="js-necessary">
                        <SearchInput
                            id="writings-tags-search-input"
                            class="search-input"
                            data-search-target="writings-tags"
                            data-search-values={JSON.stringify(tags.map(([key]) => key))}
                        >
                            Search tags by name:
                        </SearchInput>
                    </div>

                    <ul id="writings-tags">
                        {tags.map(([tag, count]) => (
                            <li data-search-value={tag}>
                                <a href={encodeURI(`/tag/${tag}`)}>{tag}</a> ({count})
                            </li>
                        ))}
                    </ul>
                </div>
            </Details>
        </Section>

        <WritingControls showExample />
    </LargeSection>

    <LargeSection>
        <Section>
            <h2>Entries</h2>

            <WritingEntries entries={entries} />
        </Section>
    </LargeSection>
</WritingPage>

<script>
    import Fuse from "fuse.js";

    const searchInputs = document.querySelectorAll<HTMLInputElement>(".search-input");
    for (const searchInput of searchInputs) {
        const searchTarget = searchInput.dataset.searchTarget!;
        const searchItems = document.querySelectorAll<HTMLElement>(`#${searchTarget} > li`);
        const searchValues = JSON.parse(searchInput.dataset.searchValues ?? "[]") as string[];

        const fuse = new Fuse(searchValues, { includeScore: true, threshold: 0.4 });

        function onSearchChanged() {
            searchItems.forEach((li) => {
                // first sort by tag name
                while (true) {
                    const prev = li.previousElementSibling;
                    if (!prev) break;

                    const searchValue = li.dataset.searchValue ?? "";
                    const prevSearchValue = (prev as HTMLElement).dataset.searchValue ?? "";
                    if (searchValue.localeCompare(prevSearchValue, undefined) < 0) {
                        li.parentNode?.insertBefore(li, prev);
                    } else {
                        break;
                    }
                }
            });

            searchItems.forEach((li) => {
                const score = Number.parseFloat(li.dataset.searchScore ?? "0");

                // score of 1 => complete mismatch
                if (score >= 1) {
                    li.hidden = true;
                } else {
                    li.hidden = false;

                    // then sort by score
                    while (true) {
                        const prev = li.previousElementSibling;
                        if (!prev) break;

                        const prevScore = Number.parseFloat((prev as HTMLElement).dataset.searchScore ?? "0");
                        if (score < prevScore) {
                            li.parentNode?.insertBefore(li, prev);
                        } else {
                            break;
                        }
                    }
                }
            });
        }

        function updateSearch() {
            if (searchInput.value) {
                const results = new Map(fuse.search(searchInput.value).map((v) => [v.item, v]));

                searchItems.forEach((li) => {
                    const result = results.get(li.dataset.searchValue ?? "");
                    li.dataset.searchScore = result?.score?.toString() ?? "1";
                });
            } else {
                searchItems.forEach((li) => {
                    li.dataset.searchScore = "0";
                });
            }

            onSearchChanged();
        }

        searchInput.addEventListener("input", () => {
            updateSearch();
        });

        document.addEventListener("DOMContentLoaded", () => {
            updateSearch();
        });
    }
</script>
