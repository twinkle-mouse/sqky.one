---
import "@sqky-one/common/assets/reset.css";
import "@sqky-one/common/assets/anims.css";
import "bluesky-profile-card-embed/style.css";
import "bluesky-profile-card-embed/themes/dark.css"; // we don't currently have a light mode colour scheme :(

import Noscript from "@sqky-one/common/assets/noscript.html";
import StarryBackground from "@sqky-one/common/components/StarryBackground.astro";
import { colorsCss } from "@sqky-one/common/lib/colors";
import type { HTMLAttributes } from "astro/types";
import { Font } from "astro:assets";
import { SEO, type TwitterCardType } from "astro-seo";
import * as mime from "mrmime";

export type Props = HTMLAttributes<"main"> & {
    siteName: string;
    desc: string;
    pageName: string;
    thumbnail?: {
        src: string;
        alt?: string;
        width: number;
        height: number;
        type?: string;
    };
    twitterCardType?: TwitterCardType;
};

const { siteName, pageName, desc: description, ...props } = Astro.props;

const title = `${pageName} — ${siteName}`;

let thumbnail;
if (props.thumbnail) {
    thumbnail = props.thumbnail;
} else {
    thumbnail = {
        src: "/favicon_512.png",
        width: 512,
        height: 512,
        alt: "A minimalist mouse icon with pink body, purple eye, and round ears, looking to the left.",
    };
}

if (!thumbnail.type) {
    thumbnail.type = mime.lookup(thumbnail.src);
}

const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en-GB" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#ffc2fe" />

        <link rel="sitemap" href="/sitemap-index.xml" />

        <link rel="icon" type="image/png" sizes="16x16" href="/favicon_16.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon_32.png" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon_48.png" />
        <link rel="apple-touch-icon" sizes="152x152" href="/favicon_152.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon_180.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon_192.png" />
        <link rel="icon" type="image/png" sizes="512x512" href="/favicon_512.png" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <SEO
            title={title}
            description={description}
            canonical={canonicalUrl}
            openGraph={{
                basic: {
                    title: pageName,
                    type: "website",
                    image: thumbnail.src,
                    url: canonicalUrl,
                },
                image: {
                    alt: thumbnail.alt,
                    width: thumbnail.width,
                    height: thumbnail.height,
                    type: thumbnail.type,
                },
                optional: {
                    siteName,
                },
            }}
            twitter={{
                title: pageName,
                description,
                card: props.twitterCardType || "summary",
                image: thumbnail.src,
                imageAlt: thumbnail.alt,
            }}
        />

        <slot name="head-tags" />

        <meta name="generator" content={Astro.generator} />

        <style
            is:raw
            set:text={`:root {
${colorsCss}
}`}
        ></style>

        <Font preload={[{ weight: 400, style: "normal" }]} cssVariable="--font-noseyrodent" />
        <Font preload cssVariable="--font-besley" />
        <Font
            preload={[
                { weight: 400, style: "normal" },
                { weight: 400, style: "italic" },
            ]}
            cssVariable="--font-iosevka-curly"
        />

        <Font cssVariable="--font-ibm-plex-sans" />
        <Font cssVariable="--font-inter" />
        <Font cssVariable="--font-noto-sans" />
        <Font cssVariable="--font-roboto" />

        <Fragment set:html={Noscript({})} />

        <slot name="style-overrides" />
    </head>

    <body>
        <div>
            <StarryBackground />
        </div>

        <div id="site">
            <slot name="nav" />

            <main {...props} id="maincontent">
                <h1 id="page-title">
                    <slot name="page-title" />
                </h1>

                <slot />
            </main>
        </div>

        <div id="popout-fakeroot"></div>
    </body>
</html>

<style is:global>
    #site {
        width: 100%;

        display: flex;

        padding-inline: calc(max(100dvw - 800px, 1rem) / 5);
    }

    main {
        padding-block: 1rem;

        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
    }

    main {
        /* navbar sidebar size */
        width: calc(100% - (320px + 1.75rem));
    }

    @media (max-width: 1300px) {
        #site {
            flex-direction: column;
        }

        main {
            width: 100%;
        }
    }

    body[data-force-mobile="true"] {
        #site {
            flex-direction: column;
        }

        main {
            width: 100%;
        }
    }

    body[data-remove-page-padding="true"] {
        #site {
            /* unfortunately, i do need at least some space to have borders still look nice and not absolutely clipped or crammed. */
            /* this is the absolute minimum amount of padding possible */
            padding-inline: 3px;
        }

        main {
            width: 100%;
        }
    }
</style>

<style is:global>
    .sr-only {
        position: absolute;
        left: -10000px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    :focus-visible {
        outline: 3px groove var(--focusColor);
    }

    :root {
        --sans: var(--font-noseyrodent), sans-serif;
        --serif: var(--font-besley), serif;
        --mono: var(--font-iosevka-curly), monospace;

        font-family: var(--sans);

        scrollbar-width: thin;
        scrollbar-gutter: auto;

        color: var(--textColor);
        background-color: var(--pageBgColor);
    }

    html,
    body {
        min-width: 100%;
        min-height: 100%;
    }

    body {
        position: relative;
    }

    .sans {
        font-family: var(--sans);
    }

    .serif {
        font-family: var(--serif);
    }

    .mono {
        font-family: var(--mono);
    }

    .text-center {
        text-align: center;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    cite,
    blockquote,
    li,
    th,
    td,
    p,
    a {
        text-wrap: wrap stable;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: var(--serif);
        color: var(--headingColor);

        border-bottom: 1px solid var(--headingColor);

        line-height: 1;
        padding-top: 0.1em;
        padding-bottom: 0.6em;
        margin-bottom: 0.1em;

        display: inline-block;
        width: 100%;
    }

    h1::before,
    h2::before,
    h3::before,
    h4::before,
    h5::before,
    h6::before {
        content: "#" / "";
        margin-right: 0.35em;
    }

    h1::after,
    h2::after,
    h3::after,
    h4::after,
    h5::after,
    h6::after {
        content: "";
        margin-left: 0.35em;
    }

    h1 {
        font-size: 3em;
        font-weight: 700;
    }

    h2 {
        font-size: 2.75em;
        font-weight: 600;
    }

    h3 {
        font-size: 1.9em;
        font-weight: 600;
    }

    h4 {
        font-size: 1.7em;
        font-weight: 500;
    }

    h5 {
        font-size: 1.4em;
        font-weight: 500;
    }

    h6 {
        font-size: 1.2em;
        font-weight: 500;
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 2.75em;
        }

        h2 {
            font-size: 1.9em;
        }

        h3 {
            font-size: 1.7em;
        }

        h4 {
            font-size: 1.4em;
        }

        h5 {
            font-size: 1.2em;
        }

        h6 {
            font-size: 1em;
        }
    }

    a {
        color: var(--linkColor);
        text-decoration: underline;
    }

    a:hover,
    a:focus {
        color: var(--linkHoverColor);
    }

    p {
        margin-block: 1.1em;
    }

    hr {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--separatorColor);
        margin-block: 2em;
    }

    b,
    strong {
        font-weight: bold;
    }

    strong {
        color: var(--strongColor);
    }

    del {
        text-decoration: line-through solid;
    }

    samp {
        font-family: var(--mono);
    }

    i,
    em {
        font-style: italic;
    }

    em {
        color: var(--emColor);
    }

    mark {
        color: var(--markColor);
        background-color: var(--markBgColor);
    }

    sup {
        vertical-align: super;
        font-size: 0.7em;
    }

    sub {
        vertical-align: sub;
        font-size: 0.7em;
    }

    small {
        font-size: 0.85em;
        color: var(--smallColor);
    }

    time {
        font-size: 0.85em;
        color: var(--smallColor);
    }

    code {
        font-size: 0.85em;
        vertical-align: 0.15em;

        display: inline;
        padding-inline: 0.15em;
        border-radius: 0.25rem;

        white-space: nowrap;

        color: var(--textColor);
        border: 1px solid var(--codeBorderColor);
        background-color: var(--codeBgColor);

        font-family: var(--mono);
    }

    blockquote {
        margin-block: 1.25em;
        margin-left: 1em;
        padding-left: 0.75em;
        border-radius: 0.35rem;
        border-left: solid var(--quoteBorderColor) 4px;
        color: var(--quoteColor);

        font-style: italic;
    }

    blockquote > :first-child::before {
        content: "“" / "";
        margin-left: 0.35em;
    }

    blockquote > :last-child::after {
        content: "”" / "";
        margin-right: 0.35em;
    }

    cite {
        display: block;
        margin-top: -1rem;
        margin-left: 2.75rem;

        color: var(--citeColor);
        font-weight: 600;
        font-style: italic;
    }

    cite::before {
        content: "—" / "";
        margin-inline: 0.35em;
    }

    /*
    cite::after {
        content: "";
        margin-inline: 0.35em;
    }
    */

    ol {
        list-style: decimal;
        padding-left: 1.5em;
        margin-block: 1em;
    }

    ul {
        list-style: disc;
        padding-left: 1em;
        margin-block: 1em;
    }

    li {
        color: var(--emColor);
    }

    textarea {
        width: 100%;

        color: var(--textAreaColor);
        background-color: var(--textAreaBgColor);
        border: 3px solid var(--textAreaBorderColor);
        border-radius: 5px;

        padding: 0.35rem;
    }

    table {
        width: 100%;

        white-space: nowrap;

        margin-block: 0.25rem;
    }

    thead {
        background-color: var(--tableHeadBgColor);
    }

    tbody {
        background-color: var(--tableBodyBgColor);
    }

    th,
    td {
        padding-inline: 1em;
        padding-block: 0.35em;
        text-align: start;
        vertical-align: middle;
        min-width: fit-content;
    }

    th {
        border: 1px solid var(--thBorderColor);
    }

    td {
        border: 1px solid var(--tdBorderColor);
    }

    details,
    summary {
        border-radius: 6px;
    }

    details {
        margin-top: 1.4rem;
        margin-bottom: 0.5rem;
        background-color: var(--detailsBgColor);
    }

    summary {
        display: flex;

        min-width: max-content;
        width: 100%;

        padding: 0.35rem;

        color: var(--summaryColor);
        text-decoration: underline dotted;
        background-color: var(--detailsBorderColor);
        outline: 3px solid var(--detailsBorderColor);
    }

    details > :not(summary) {
        background: none;
        border: none;

        padding-block: 1px;
        padding-inline: 0.9em;

        margin-top: 6px;
        border-top-left-radius: 0;
        border-top-right-radius: 0;
        outline: 3px solid var(--detailsBorderColor);
    }

    input,
    label,
    button,
    input::file-selector-button {
        display: inline-block;

        font-family: var(--sans);
        text-decoration: underline;
        text-underline-offset: 15%;

        color: var(--buttonTextColor);
    }

    button,
    input::file-selector-button {
        user-select: none;
        cursor: pointer;

        margin: 0.5rem;
        padding: 0.5rem;
        border-radius: 0.4rem;

        background-color: var(--buttonBgColor);
        border: 3px solid var(--buttonBorderColor);
    }

    button:hover,
    button:focus-visible,
    input:hover::file-selector-button,
    input:focus-visible::file-selector-button {
        color: var(--buttonHoverTextColor);
        background-color: var(--buttonHoverBgColor);
        border-color: var(--buttonHoverBorderColor);
    }

    button:active,
    input:active::file-selector-button {
        color: var(--buttonActiveTextColor);
        background-color: var(--buttonActiveBgColor);
        border-color: var(--buttonActiveBorderColor);
    }

    a:focus-visible,
    input:focus-visible {
        outline: 2px solid var(--focusColor);
    }

    img:focus-visible,
    summary:focus-visible,
    textarea:focus-visible,
    button:focus-visible {
        outline: 3px solid var(--focusColor);
    }

    summary:focus {
        outline-color: var(--focusColor);
    }

    textarea:focus {
        outline-color: var(--focusColor);
    }

    abbr {
        text-decoration: dotted underline;
    }

    img {
        object-fit: scale-down;
    }

    picture,
    img {
        display: block;
        line-height: 0;
    }

    fieldset {
        border: 2px solid var(--articleBorderColor);
        padding-inline: 1rem;
        padding-bottom: 1.2rem;
        margin-top: 1.2rem;
        background-color: var(--articleBgColor);
    }

    fieldset > :last-child {
        margin-bottom: 0;
        padding-bottom: 0;
    }

    #page-title {
        text-align: center;

        margin-top: 0.2em;
        padding-bottom: 0.6em;
        margin-bottom: 0.4em;

        text-shadow: 0px 0px 8px rgba(255, 255, 255, 0.4);
    }

    #page-title::before {
        content: "“" / "";
        margin-left: 0.2em;
    }

    #page-title::after {
        content: "”" / "";
        margin-right: 0.2em;
    }

    .animation-rotate {
        display: inline-block;
        animation: rotate 2s linear infinite;
    }

    @media (prefers-reduced-motion) {
        .animation-rotate {
            animation: none;
        }
    }

    #popout-fakeroot {
        position: absolute;
        top: 0;
        left: 0;

        padding: 0;
        margin: 0;

        width: 100%;
        height: 100%;

        overflow: clip;
        pointer-events: none;
        user-select: none;
    }

    #popout-fakeroot > * {
        text-rendering: optimizeLegibility;
        will-change: transform;

        pointer-events: auto;
        user-select: none;
    }

    #popout-fakeroot::before {
        content: "";
        width: 100%;
        height: 100%;
        display: block;
    }

    .cursor-grab,
    #popout-fakeroot:has(> .cursor-grab)::before {
        cursor: grab !important;
        pointer-events: auto;
    }

    .cursor-grabbing,
    #popout-fakeroot:has(> .cursor-grabbing)::before {
        cursor: grabbing !important;
        pointer-events: auto;
    }

    .text-trans,
    .text-nb,
    .text-aroace,
    .text-agere {
        background-clip: text;
        color: #ffffff80;
    }

    .text-trans {
        background-image: linear-gradient(
            -45deg,
            #5ccefa,
            #5ccefa 20%,
            #f6a8b7 20%,
            #f6a8b7 40%,
            #fff 40%,
            #fff 60%,
            #f6a8b7 60%,
            #f6a8b7 80%,
            #5ccefa 80%,
            #5ccefa
        );
    }

    .text-nb {
        background-image: linear-gradient(-45deg, #fdf52f, #fdf52f 25%, #fff 25%, #fff 50%, #9d5ad2 50%, #9d5ad2 75%, #000 75%, #000);
    }

    .text-aroace {
        background-image: linear-gradient(
            -45deg,
            #e38c01,
            #e38c01 20%,
            #eccd00 20%,
            #eccd00 40%,
            #fff 40%,
            #fff 60%,
            #62afde 60%,
            #62afde 80%,
            #203857 80%,
            #203857
        );
    }

    .text-agere {
        background-image: linear-gradient(-45deg, #fff, #fff 25%, #fdc1c8 25%, #fdc1c8 50%, #afe1fd 50%, #afe1fd 75%, #fcf77c 75%, #fcf77c);
    }
</style>
