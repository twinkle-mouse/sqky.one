---
import type { HTMLAttributes } from "astro/types";

export type Props = Omit<HTMLAttributes<"input">, "type">;

const { id, ...props } = Astro.props;
---

<label for={id}>
    <slot />
    <input id={id} type="search" {...props} />
</label>

<style>
    input {
        color: var(--textColor);
        text-decoration: none;
    }

    label {
        width: fit-content;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-block: 1rem;
    }

    input {
        background-color: var(--buttonBgColor);
        border: 1px solid var(--buttonBorderColor);
    }
</style>
