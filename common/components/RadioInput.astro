---
import { Dot } from "@sqky-one/common/assets/Icons";
import type { HTMLAttributes } from "astro/types";

export type Props = Omit<HTMLAttributes<"input">, "type">;

const { id, ...props } = Astro.props;
---

<input id={id} type="radio" {...props} />
<label for={id}>
    <Dot class="icon" aria-hidden="true" />
    <slot />
</label>

<style>
    input,
    label {
        user-select: none;
        cursor: pointer;
    }

    input {
        width: 1px;
        height: 0px;
        opacity: 0;
    }

    label {
        padding-block: 0.2rem;
        padding-inline: 0.2rem;
        margin-block: 0.2rem;
        margin-left: 0.3rem;
    }

    input:hover,
    input:hover + label,
    input:focus-visible,
    input:focus-visible + label {
        color: var(--buttonHoverTextColor);
    }

    input:active,
    input:active + label {
        color: var(--buttonActiveTextColor);
    }

    input:focus-visible + label {
        outline: 2px solid var(--focusColor);
    }

    .icon {
        padding: 0.125em;
        margin-right: 0.3em;

        vertical-align: middle;

        width: 1.5em;
        height: 1.5em;

        border-radius: 9999px;
        border: 0.3em solid;

        background-color: var(--inputBgColor);
        border-color: var(--inputBorderColor);
        color: transparent;
    }

    input:checked + label > .icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
        color: #000;
    }

    input:hover + label > .icon,
    input:focus-visible + label > .icon {
        background-color: var(--inputHoverBgColor);
        border-color: var(--inputHoverBorderColor);
    }

    input:active + label > .icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
    }
</style>
