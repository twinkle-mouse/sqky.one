---
import { Cross } from "@sqky-one/common/assets/Icons";
import type { HTMLAttributes } from "astro/types";

export type Props = Omit<HTMLAttributes<"input">, "type">;

const { id, ...props } = Astro.props;

const slot = await Astro.slots.render("default");
---

<label for={id}>
    <Cross class="icon" aria-hidden="true" />
    {slot.trim()}
    <input id={id} type="checkbox" {...props} />
</label>

<style>
    input,
    label {
        user-select: none;
        cursor: pointer;
    }

    input {
        width: 0px;
        height: 0px;
        opacity: 0;
    }

    label {
        padding-block: 0.125rem;
        padding-right: 0.5rem;
    }

    input:hover,
    label:has(> input:hover),
    input:focus-visible,
    label:has(> input:focus-visible) {
        color: var(--buttonHoverTextColor);
    }

    input:active,
    label:has(> input:active) {
        color: var(--buttonActiveTextColor);
    }

    label:has(> input:focus-visible) {
        outline: 2px solid var(--focusColor);
    }

    .icon {
        padding: 0.125em;
        margin-right: 0.3em;

        vertical-align: middle;

        width: 1.5em;
        height: 1.5em;

        border-radius: 9999px;
        border: 0.3em solid;

        background-color: var(--inputBgColor);
        border-color: var(--inputBorderColor);
        color: transparent;
    }

    label:has(> input:checked) > .icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
        color: #000;
    }

    label:has(> input:hover) > .icon,
    label:has(> input:focus-visible) > .icon {
        background-color: var(--inputHoverBgColor);
        border-color: var(--inputHoverBorderColor);
    }

    label:has(> input:active) > .icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
    }
</style>
