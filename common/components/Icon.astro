---
import { Icon } from "astro-icon/components";

export type Props = Parameters<typeof Icon>[0] & {
    size?: "icon" | "emoji";
};

const { size = "icon", class: clazz, ...props } = Astro.props;

let ariaHidden: "true" | undefined = undefined;
if (!props.title) {
    ariaHidden = "true";
}

let resolvedSize = "";
if (size == "icon") {
    resolvedSize = "1.5em";
} else if (size == "emoji") {
    resolvedSize = "1.2em";
}
---

<Icon aria-hidden={ariaHidden} width={resolvedSize} height={resolvedSize} class:list={[size, clazz]} {...props} />

<style>
    .emoji,
    .icon {
        display: inline-block;
        line-height: 0;
    }

    .emoji {
        vertical-align: text-bottom;
    }

    .icon {
        vertical-align: -0.4em;
    }
</style>
