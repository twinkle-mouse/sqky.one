---
import { randomUUID } from "node:crypto";
import fs from "node:fs";
import path from "node:path";

import type { HTMLAttributes } from "astro/types";
import { publicDir } from "astro:config/server";

import Details from "./Details.astro";

export type Props = HTMLAttributes<"textarea"> & {
    src: string;
    summary?: string;
};

const { src, summary, class: cls, ...props } = Astro.props;
const file = fs.readFileSync(path.join(publicDir.pathname, src), { encoding: "utf8" });

const uuid = `textfile-${randomUUID()}`;
---

<Details src={src} summary={summary}>
    <textarea aria-label={`Content of file ${src}`} id={uuid} readonly cols="64" rows="14" {...props} class:list={["mono", cls]}>{file}</textarea>
</Details>

<style>
    textarea {
        padding: 0.4rem;
        text-wrap: nowrap;
    }
</style>
