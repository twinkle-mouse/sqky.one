---
import type { HTMLAttributes } from "astro/types";

import Icon from "./Icon.astro";

export type Props = HTMLAttributes<"details"> & {
    src?: string;
    summary?: string;
};

const { src, summary, ...props } = Astro.props;
---

<details {...props}>
    <summary>
        <Icon class="open-icon" name="symbol/caret-right" />
        <span>{summary}</span>
        {src && (
            <a class="mono" href={encodeURI(src)}>
                {src}
            </a>
        )}
    </summary>

    <slot />
</details>

<style>
    .open-icon {
        flex: none;

        margin-top: -0.1em;

        color: #fff;

        transform-origin: center center;
        transition: transform 0.2s ease;
    }

    @media (prefers-reduced-motion) {
        .open-icon {
            transition: none;
        }
    }

    summary > span {
        margin-left: 0.3em;
        margin-right: 1em;
    }

    summary > a {
        display: inline-block;
        height: min-content;
        margin-left: auto;
    }

    details[open] > summary {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

    details[open] > summary > .open-icon {
        transform: rotate(90deg);
    }

    details:not([open]) > summary > .open-icon {
        transform: rotate(0deg);
    }
</style>
