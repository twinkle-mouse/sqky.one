---
import type { HTMLAttributes } from "astro/types";

import Icon from "./Icon.astro";

export type Props = HTMLAttributes<"input"> & {
    labelProps?: HTMLAttributes<"label">;
    id: string;
    iconName?: string;
    shouldSaveValue?: boolean;
};

const { id, iconName, shouldSaveValue = false, class: clazz, labelProps, ...props } = Astro.props;

const slot = await Astro.slots.render("default");

if (!slot) {
    throw Error("Input must have text children!");
}

if (shouldSaveValue && !props.name) {
    throw Error("Input must have `name` if `shouldSaveValue` is set");
}
---

<label for={id} {...labelProps}>
    {iconName && (
        <>
            <Icon class="input-icon" name={iconName} />{" "}
        </>
    )}
    <span>{slot.trim()}</span>
    <input id={id} {...props} class:list={[shouldSaveValue && "input-auto-save-value", clazz]} />
</label>

<style>
    label {
        display: inline-block;
    }

    input,
    label > span {
        display: inline-block;

        font-family: var(--sans);
        text-decoration: underline solid 1px;
        text-underline-offset: 15%;

        color: var(--buttonTextColor);
    }
</style>

<style lang="scss">
    @mixin button-style($type) {
        input[type="#{$type}"] {
            width: 0px;
            height: 0px;
            opacity: 0;
        }

        label:has(> input[type="#{$type}"]) {
            user-select: none;
            cursor: pointer;

            padding-block: 0.2rem;
            margin-right: 0.35rem;
        }

        input[type="#{$type}"]:hover,
        input[type="#{$type}"]:focus-visible,
        label:has(> input[type="#{$type}"]:hover) > span,
        label:has(> input[type="#{$type}"]:focus-visible) > span {
            color: var(--buttonHoverTextColor);
        }

        input[type="#{$type}"]:active,
        label:has(> input[type="#{$type}"]:active) > span {
            color: var(--buttonActiveTextColor);
        }

        label:has(> input[type="#{$type}"]:focus-visible) {
            outline: 2px solid var(--focusColor);
        }
    }

    @mixin text-style($type) {
        input[type="#{$type}"] {
            color: var(--textColor);
            text-decoration: none;

            background-color: var(--buttonBgColor);
            outline: 1px solid var(--buttonBorderColor);
        }

        label:has(> input[type="#{$type}"]) {
            width: fit-content;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5em;
            margin-block: 1em;
        }

        input[type="#{$type}"]:focus-visible {
            outline: 2px solid var(--focusColor);
        }
    }

    @include button-style("radio");
    @include button-style("checkbox");

    @include text-style("text");
    @include text-style("search");
    @include text-style("number");
</style>

<style>
    .input-icon {
        padding: 0.125em;

        vertical-align: middle;

        border-radius: 9999px;
        border: 0.3em solid;

        background-color: var(--inputBgColor);
        border-color: var(--inputBorderColor);
        color: transparent;
    }

    label:has(> input:checked) > .input-icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
        color: #000;
    }

    label:has(> input:hover) > .input-icon,
    label:has(> input:focus-visible) > .input-icon {
        background-color: var(--inputHoverBgColor);
        border-color: var(--inputHoverBorderColor);
    }

    label:has(> input:active) > .input-icon {
        background-color: var(--inputActiveBgColor);
        border-color: var(--inputActiveBorderColor);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const radioInputCache = new Map<string, HTMLInputElement[]>();
        const inputs = document.querySelectorAll<HTMLInputElement>("input.input-auto-save-value");
        const restoredInputs: HTMLInputElement[] = [];

        window.__inputAutoSaveCurrentlyRestoringInputs = false;

        inputs.forEach((input) => {
            const key = `input-${input.name}`;

            const storedValue = window.localStorage.getItem(key);
            if (storedValue) {
                switch (input.type) {
                    case "number":
                    case "color":
                    case "date":
                    case "search":
                    case "text":
                    case "time":
                        input.value = storedValue;
                        break;
                    case "checkbox":
                        input.checked = storedValue === true.toString();
                        break;
                    case "radio":
                        (document.getElementById(storedValue)! as HTMLInputElement).checked = true;
                        break;
                    default:
                        throw Error(`Unhandled input type ${input.type}`);
                }

                restoredInputs.push(input);
            }

            input.addEventListener("change", () => {
                if (window.__inputAutoSaveCurrentlyRestoringInputs) return;

                switch (input.type) {
                    case "number":
                    case "color":
                    case "date":
                    case "search":
                    case "text":
                    case "time":
                        if (input.value) {
                            window.localStorage.setItem(key, input.value);
                        } else {
                            window.localStorage.removeItem(key);
                        }
                        break;
                    case "checkbox":
                        if (input.checked) {
                            window.localStorage.setItem(key, "true");
                        } else {
                            window.localStorage.removeItem(key);
                        }
                        break;
                    case "radio":
                        if (input.checked) {
                            window.localStorage.setItem(key, input.id);
                        } else {
                            if (radioInputCache.get(input.name) == undefined) {
                                radioInputCache.set(input.name, [...document.querySelectorAll<HTMLInputElement>(`input[name="${input.name}"]`)]);
                            }

                            if (radioInputCache.get(input.name)!.every((e) => !e.checked)) {
                                window.localStorage.removeItem(key);
                            }
                        }
                        break;
                    default:
                        throw Error(`Unhandled input type ${input.type}`);
                }
            });
        });

        // only dispatch event after two frames so other listeners of DOMContentLoaded can register their own listeners,
        // and also after those listeners have also dispatched their own events post-initialization
        window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
                window.__inputAutoSaveCurrentlyRestoringInputs = true;
                restoredInputs.forEach((input) => {
                    input.dispatchEvent(new InputEvent("change"));
                });

                // wait another frame because listeners could dispatch events too when "change" is fired
                window.requestAnimationFrame(() => {
                    window.__inputAutoSaveCurrentlyRestoringInputs = false;
                });
            });
        });
    });
</script>
