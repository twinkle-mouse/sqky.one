---
import Icon, { type Props as P } from "./Icon.astro";

export type Props = Omit<P, "size">;

const { class: clazz, name, ...props } = Astro.props;
---

<Icon size="icon" class:list={["file-icon", clazz]} name={`material-file/${name}`} {...props} />

<style>
    .file-icon {
        color: var(--slate300);
        margin-right: 0.4em;
    }
</style>
