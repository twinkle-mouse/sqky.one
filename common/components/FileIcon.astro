---
import { Icon as AstroIcon } from "astro-icon/components";

export type Props = {
    icon: string;
};
---

<AstroIcon aria-hidden="true" role="img" class="file-icon" name=`material-file/${Astro.props.icon}` width="1.5em" height="1.5em" />

<style>
    .file-icon {
        color: var(--slate300);
        display: inline-block;
        vertical-align: -0.4em;
        margin-right: 0.4em;
    }
</style>
