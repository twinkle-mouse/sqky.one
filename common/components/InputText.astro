---
import Input, { type Props as P } from "./Input.astro";

export type Props = Omit<P, "type">;

const { ...props } = Astro.props;
---

<Input type="text" {...props}>
    <slot />
</Input>

<style is:global>
    input[type="text"] {
        color: var(--textColor);
        text-decoration: none;

        background-color: var(--buttonBgColor);
        outline: 1px solid var(--buttonBorderColor);
    }

    label:has(> input[type="text"]) {
        width: fit-content;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5em;
        margin-block: 1em;
    }
</style>
